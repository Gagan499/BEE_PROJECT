<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="shortcut icon"
      href="/assets/images/favicon_icon.png"
      type="image/x-icon"
    />
    <title>Contact Us - Palm Ways</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/assets/css/theme.css" />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              poppins: ["Poppins", "sans-serif"],
            },
            colors: {
              "primary-teal": "#008080",
              "secondary-teal": "#00cec9",
              "dark-teal": "#1a535c",
              "light-mint": "#e6f7f7",
            },
          },
        },
      };
    </script>
    <style>
      body {
        font-family: "Poppins", sans-serif;
      }
    </style>
  </head>
  <body class="font-poppins min-h-screen pt-[76px]">
    <%- include('partials/navbar') %> <%- include('partials/alert') %>

    <!-- Hero Section -->
    <section
      class="bg-gradient-to-br from-primary-teal to-secondary-teal py-16 px-4 md:px-8 text-white text-center"
    >
      <div class="max-w-4xl mx-auto">
        <div
          class="inline-flex items-center gap-2 bg-white/20 px-4 py-2 rounded-full text-sm mb-4"
        >
          <i class="fas fa-envelope"></i>
          <span>Get in Touch</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Contact Us</h1>
        <p class="text-lg md:text-xl opacity-95">
          We're here to help! Send us a message and we'll respond within 24
          hours.
        </p>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="max-w-6xl mx-auto py-12 px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Contact Information -->
        <div>
          <h2 class="text-3xl font-bold text-gray-800 mb-6">Contact Information</h2>
          <p class="text-gray-600 mb-8">
            Our team is here to help you plan the perfect stay. Reach out to us
            through any of the following channels.
          </p>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div
                class="w-14 h-14 bg-gradient-to-br from-primary-teal to-secondary-teal rounded-xl flex items-center justify-center text-white text-xl flex-shrink-0"
              >
                <i class="fas fa-phone"></i>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-800 mb-1">
                  Call Us
                </h3>
                <p class="text-gray-600">+1 (234) 567-890</p>
                <p class="text-sm text-gray-500">Available 24/7</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="w-14 h-14 bg-gradient-to-br from-primary-teal to-secondary-teal rounded-xl flex items-center justify-center text-white text-xl flex-shrink-0"
              >
                <i class="fas fa-envelope"></i>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-800 mb-1">
                  Email Us
                </h3>
                <p class="text-gray-600">info@palmways.com</p>
                <p class="text-sm text-gray-500">Response within 24 hours</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="w-14 h-14 bg-gradient-to-br from-primary-teal to-secondary-teal rounded-xl flex items-center justify-center text-white text-xl flex-shrink-0"
              >
                <i class="fas fa-map-marker-alt"></i>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-800 mb-1">
                  Visit Us
                </h3>
                <p class="text-gray-600">123 Paradise Beach Road</p>
                <p class="text-sm text-gray-500">Tropical Island, PI 12345</p>
              </div>
            </div>
          </div>

          <!-- Social Media -->
          <div class="mt-8 pt-8 border-t border-gray-200">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">
              Follow Us
            </h3>
            <div class="flex gap-4">
              <a
                href="#"
                class="w-12 h-12 bg-gray-100 hover:bg-primary-teal rounded-lg flex items-center justify-center text-gray-600 hover:text-white transition-all"
              >
                <i class="fab fa-facebook-f"></i>
              </a>
              <a
                href="#"
                class="w-12 h-12 bg-gray-100 hover:bg-primary-teal rounded-lg flex items-center justify-center text-gray-600 hover:text-white transition-all"
              >
                <i class="fab fa-twitter"></i>
              </a>
              <a
                href="#"
                class="w-12 h-12 bg-gray-100 hover:bg-primary-teal rounded-lg flex items-center justify-center text-gray-600 hover:text-white transition-all"
              >
                <i class="fab fa-instagram"></i>
              </a>
              <a
                href="#"
                class="w-12 h-12 bg-gray-100 hover:bg-primary-teal rounded-lg flex items-center justify-center text-gray-600 hover:text-white transition-all"
              >
                <i class="fab fa-linkedin-in"></i>
              </a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-white rounded-2xl shadow-lg p-8">
          <h2 class="text-3xl font-bold text-gray-800 mb-6">Send us a Message</h2>
          <form id="contactForm" class="space-y-6">
            <div>
              <label
                for="name"
                class="block text-sm font-semibold text-gray-700 mb-2"
                >Your Name <span class="text-red-500">*</span></label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-primary-teal transition-colors"
                placeholder="John Doe"
              />
            </div>

            <div>
              <label
                for="email"
                class="block text-sm font-semibold text-gray-700 mb-2"
                >Email Address <span class="text-red-500">*</span></label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-primary-teal transition-colors"
                placeholder="john@example.com"
              />
            </div>

            <div>
              <label
                for="message"
                class="block text-sm font-semibold text-gray-700 mb-2"
                >Message <span class="text-red-500">*</span></label
              >
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-primary-teal transition-colors resize-y"
                placeholder="Tell us how we can help you..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-gradient-to-br from-primary-teal to-secondary-teal text-white py-4 rounded-lg font-semibold text-lg hover:opacity-90 transition-all hover:shadow-xl"
            >
              <i class="fas fa-paper-plane mr-2"></i>Send Message
            </button>
          </form>
          <div id="contactFormMessage" class="mt-4 hidden"></div>
        </div>
      </div>
    </section>

    <%- include('partials/footer') %>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const contactForm = document.getElementById("contactForm");
        const contactFormMessage = document.getElementById("contactFormMessage");

        if (contactForm) {
          contactForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const name = document.getElementById("name").value;
            const email = document.getElementById("email").value;
            const message = document.getElementById("message").value;

            // Show loading state
            const submitButton = contactForm.querySelector('button[type="submit"]');
            const originalHTML = submitButton.innerHTML;
            submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
            submitButton.disabled = true;

            try {
              const response = await fetch("/api/contact", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({ name, email, message }),
              });
              const result = await response.json();

              if (result.success) {
                contactFormMessage.style.display = "block";
                contactFormMessage.className = "mt-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-800";
                contactFormMessage.textContent =
                  result.message ||
                  `Thank you, ${name}! Your message has been received. We'll get back to you at ${email} soon.`;
                contactForm.reset();
              } else {
                contactFormMessage.style.display = "block";
                contactFormMessage.className = "mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800";
                contactFormMessage.textContent =
                  result.message || "Failed to send message. Please try again.";
              }
            } catch (error) {
              console.error("Error submitting contact form:", error);
              contactFormMessage.style.display = "block";
              contactFormMessage.className = "mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800";
              contactFormMessage.textContent =
                "An error occurred. Please try again later.";
            } finally {
              submitButton.innerHTML = originalHTML;
              submitButton.disabled = false;

              setTimeout(() => {
                if (contactFormMessage) {
                  contactFormMessage.style.display = "none";
                }
              }, 5000);
            }
          });
        }
      });
    </script>
  </body>
</html>

