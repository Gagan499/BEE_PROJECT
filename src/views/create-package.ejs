<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Package - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/assets/css/theme.css" />
    <link rel="stylesheet" href="/assets/css/create-package.css" />
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              'poppins': ['Poppins', 'sans-serif']
            },
            colors: {
              'primary-teal': '#008080',
              'secondary-teal': '#00cec9',
              'dark-teal': '#1a535c',
              'light-mint': '#e6f7f7',
              'accent-blue': '#00bfff',
            }
          }
        }
      }
    </script>
  </head>
  <body class="font-poppins min-h-screen pt-[76px] transition-colors duration-300">
    <%- include('partials/navbar') %> <%- include('partials/alert') %>

    <div class="max-w-4xl mx-auto p-8">
      <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-800 mb-2">
          Create New Package
        </h1>
        <p class="text-gray-500">Add a new vacation package to the website</p>
      </div>

      <form id="packageForm" class="bg-white rounded-2xl shadow-lg p-8">
        <!-- Package Name -->
        <div class="mb-6">
          <label
            for="packageName"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Package Name <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="packageName"
            name="packageName"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="e.g., Tropical Paradise Getaway"
          />
        </div>

        <!-- Title (Optional) -->
        <div class="mb-6">
          <label
            for="title"
            class="block text-sm font-semibold text-gray-700 mb-2"
            >Title</label
          >
          <input
            type="text"
            id="title"
            name="title"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="Optional title"
          />
        </div>

        <!-- Type -->
        <div class="mb-6">
          <label
            for="type"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Type <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="type"
            name="type"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="e.g., Beach, Mountain, City"
          />
        </div>

        <!-- Description -->
        <div class="mb-6">
          <label
            for="description"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Description <span class="text-red-500">*</span>
          </label>
          <textarea
            id="description"
            name="description"
            required
            rows="4"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="Describe the package..."
          ></textarea>
        </div>

        <!-- Stay -->
        <div class="mb-6">
          <label
            for="Stay"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Stay <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="Stay"
            name="Stay"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="e.g., 3 Nights / 4 Days"
          />
        </div>

        <!-- Hotel Name -->
        <div class="mb-6">
          <label
            for="hotelName"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Hotel Name <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="hotelName"
            name="hotelName"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="e.g., Palm Ways Resort"
          />
        </div>

        <!-- Location -->
        <div class="mb-6">
          <label
            for="location"
            class="block text-sm font-semibold text-gray-700 mb-2"
            >Location</label
          >
          <input
            type="text"
            id="location"
            name="location"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="e.g., Maldives, Bali"
          />
        </div>

        <!-- Price -->
        <div class="mb-6">
          <label
            for="price"
            class="block text-sm font-semibold text-gray-700 mb-2"
            >Price</label
          >
          <input
            type="number"
            id="price"
            name="price"
            step="0.01"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="e.g., 299.99"
          />
        </div>

        <!-- Days & Nights -->
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div>
            <label
              for="days"
              class="block text-sm font-semibold text-gray-700 mb-2"
              >Days</label
            >
            <input
              type="number"
              id="days"
              name="days"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
              placeholder="e.g., 4"
            />
          </div>
          <div>
            <label
              for="nights"
              class="block text-sm font-semibold text-gray-700 mb-2"
              >Nights</label
            >
            <input
              type="number"
              id="nights"
              name="nights"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
              placeholder="e.g., 3"
            />
          </div>
        </div>

        <!-- Duration -->
        <div class="mb-6">
          <label
            for="duration"
            class="block text-sm font-semibold text-gray-700 mb-2"
            >Duration</label
          >
          <input
            type="text"
            id="duration"
            name="duration"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="e.g., 3N/4D"
          />
        </div>

        <!-- Image URL -->
        <div class="mb-6">
          <label
            for="image"
            class="block text-sm font-semibold text-gray-700 mb-2"
            >Image URL</label
          >
          <input
            type="url"
            id="image"
            name="image"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="https://example.com/image.jpg"
          />
        </div>

        <!-- Badge -->
        <div class="mb-6">
          <label
            for="badge"
            class="block text-sm font-semibold text-gray-700 mb-2"
            >Badge</label
          >
          <input
            type="text"
            id="badge"
            name="badge"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="e.g., Best Value, Most Popular"
          />
        </div>

        <!-- Icon (Font Awesome class) -->
        <div class="mb-6">
          <label
            for="icon"
            class="block text-sm font-semibold text-gray-700 mb-2"
            >Icon (Font Awesome)</label
          >
          <input
            type="text"
            id="icon"
            name="icon"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="e.g., fa-umbrella-beach"
          />
        </div>

        <!-- Activities -->
        <div class="mb-6">
          <label
            for="activities"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Activities <span class="text-red-500">*</span> (One per line)
          </label>
          <textarea
            id="activities"
            name="activities"
            required
            rows="5"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="Swimming&#10;Snorkeling&#10;Beach Volleyball"
          ></textarea>
          <p class="text-xs text-gray-500 mt-1">
            Enter each activity on a new line
          </p>
        </div>

        <!-- Features (Optional) -->
        <div class="mb-6">
          <label
            for="features"
            class="block text-sm font-semibold text-gray-700 mb-2"
            >Features (Optional, one per line)</label
          >
          <textarea
            id="features"
            name="features"
            rows="4"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-teal focus:border-transparent"
            placeholder="Free WiFi&#10;Breakfast Included&#10;Pool Access"
          ></textarea>
        </div>

        <!-- Form Actions -->
        <div class="flex gap-4 mt-8">
          <button
            type="submit"
            class="flex-1 teal-gradient text-white py-3 px-6 rounded-lg font-semibold hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-save mr-2"></i>Create Package
          </button>
          <button
            type="button"
            onclick="window.location.href='/api/admin'"
            class="px-6 py-3 border border-gray-300 rounded-lg font-semibold text-gray-700 hover:bg-gray-50 transition-colors"
          >
            Cancel
          </button>
        </div>
      </form>

      <div id="message" class="mt-4 hidden"></div>
    </div>

    <%- include('partials/footer') %>

    <script src="/assets/js/create-package.js"></script>
  </body>
</html>
