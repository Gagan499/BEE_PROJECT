<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="shortcut icon" href="/assets/images/favicon_icon.png" type="image/x-icon">
    <title>Login & Sign Up</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Poppins', sans-serif; } </style>
</head>
<body class="bg-gradient-to-tr from-[#1E202B] to-[#2D2F3E] flex items-center justify-center min-h-screen"
      style="background-image: url('/assets/images/LoginFormBG.png'); background-size: cover; background-position: center;">

  <div id="container" class="group relative w-full max-w-4xl min-h-[550px] bg-[#282A37]/60 rounded-2xl shadow-2xl backdrop-blur-sm overflow-hidden">

    <div class="absolute top-0 left-0 h-full w-[200%] flex transition-transform duration-700 ease-in-out z-10 group-[&.right-panel-active]:-translate-x-1/2 will-change-transform">

      <div class="w-1/2 h-full flex items-center justify-start">
        <form id="loginform" method="POST" class="flex flex-col items-start px-16 w-1/2">
          <h2 class="text-4xl font-bold text-white mb-12">Sign In</h2>
          <div class="relative w-full my-4">
            <input id="email-signin" name="email" type="email" required class="peer w-full py-2 bg-transparent border-b-2 border-gray-500/50 text-white placeholder-transparent focus:outline-none focus:border-purple-500" placeholder="Email Address">
            <label for="email-signin" class="absolute left-0 -top-4 text-gray-400 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-placeholder-shown:top-2 peer-focus:-top-4 peer-focus:text-purple-400 peer-focus:text-sm">Email Address</label>
          </div>
          <div class="relative w-full my-4">
            <input id="password-signin" name="password" type="password" required class="peer w-full py-2 bg-transparent border-b-2 border-gray-500/50 text-white placeholder-transparent focus:outline-none focus:border-purple-500" placeholder="Password">
            <label for="password-signin" class="absolute left-0 -top-4 text-gray-400 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-placeholder-shown:top-2 peer-focus:-top-4 peer-focus:text-purple-400 peer-focus:text-sm">Password</label>
          </div>
          <button type="submit" class="w-full mt-8 py-3 text-lg font-semibold text-white bg-[#25A85B] rounded-lg shadow-lg hover:scale-105 transition-transform duration-300">Sign In</button>
        </form>
      </div>
      <div class="w-1/2 h-full flex items-center justify-end">
        <form id="registerform" method="POST" class="flex flex-col items-start px-16 w-1/2">
          <h2 class="text-4xl font-bold text-white mb-12">Sign Up</h2>
          <div class="relative w-full my-4">
            <input id="name-signup" name="name" type="text" required class="peer w-full py-2 bg-transparent border-b-2 border-gray-500/50 text-white placeholder-transparent focus:outline-none focus:border-purple-500" placeholder="Name">
            <label for="name-signup" class="absolute left-0 -top-4 text-gray-400 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-placeholder-shown:top-2 peer-focus:-top-4 peer-focus:text-purple-400 peer-focus:text-sm">Name</label>
          </div>
          <div class="relative w-full my-4">
            <input id="email-signup" name="email" type="email" required class="peer w-full py-2 bg-transparent border-b-2 border-gray-500/50 text-white placeholder-transparent focus:outline-none focus:border-purple-500" placeholder="Email Address">
            <label for="email-signup" class="absolute left-0 -top-4 text-gray-400 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-placeholder-shown:top-2 peer-focus:-top-4 peer-focus:text-purple-400 peer-focus:text-sm">Email Address</label>
          </div>
          <div class="relative w-full my-4">
            <input id="password-signup" name="password" type="password" required class="peer w-full py-2 bg-transparent border-b-2 border-gray-500/50 text-white placeholder-transparent focus:outline-none focus:border-purple-500" placeholder="Password">
            <label for="password-signup" class="absolute left-0 -top-4 text-gray-400 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-placeholder-shown:top-2 peer-focus:-top-4 peer-focus:text-purple-400 peer-focus:text-sm">Password</label>
          </div>
            <button type="submit" class="w-full mt-8 py-3 text-lg font-semibold text-white bg-[#25A85B] rounded-lg shadow-lg hover:scale-105 transition-transform duration-300">Sign Up</button>
        </form>
      </div>
    </div>

    <div class="absolute top-0 left-1/2 w-1/2 h-full overflow-hidden transition-transform duration-700 ease-in-out z-20 group-[&.right-panel-active]:-translate-x-full will-change-transform">
      <div class="relative -left-full h-full w-[200%] bg-gradient-to-br from-[#2A7B9B] to-[#16A34A] text-white transition-transform duration-700 ease-in-out group-[&.right-panel-active]:translate-x-1/2">
        <div class="absolute top-0 h-full w-1/2 flex items-center justify-center flex-col px-10 text-center">
          <h1 class="text-4xl font-bold">Welcome Back!</h1>
          <p class="text-base font-light tracking-wide my-5 max-w-xs">To keep connected with us please login with your personal info</p>
          <button id="signIn" class="px-10 py-2.5 font-semibold bg-transparent border-2 border-white rounded-full uppercase tracking-wider hover:bg-white hover:text-black transition-colors duration-300 cursor-pointer">Sign In</button>
        </div>
        <div class="absolute top-0 right-0 h-full w-1/2 flex items-center justify-center flex-col px-10 text-center">
          <h1 class="text-4xl font-bold">Hello, Friend!</h1>
          <p class="text-base font-light tracking-wide my-5 max-w-xs">Enter your personal details and start your journey with us</p>
          <button id="signUp" class="px-10 py-2.5 font-semibold bg-transparent border-2 border-white rounded-full uppercase tracking-wider hover:bg-white hover:text-black transition-colors duration-300 cursor-pointer">Sign Up</button>
        </div>
      </div>
    </div>

  </div>

  <script>
    const signUpButton = document.getElementById('signUp');
    const signInButton = document.getElementById('signIn');
    const container = document.getElementById('container');

    signUpButton.addEventListener('click', () => {
      container.classList.add('right-panel-active');
    });

    signInButton.addEventListener('click', () => {
      container.classList.remove('right-panel-active');
    });
  </script>
  <script>
    const loginform = document.getElementById('loginform');
    const registerform = document.getElementById('registerform');
    const api = window.location.origin;

    // login form intergration
    loginform.addEventListener('submit',async (e)=>{
      e.preventDefault();
      let email = document.getElementById('email-signin').value;
      let password = document.getElementById('password-signin').value;

      let data = await fetch(`${api}/auth/login`,{
        method:'POST',
        headers:{
          'Content-Type':'application/json'
        },
        body:JSON.stringify({email,password})
      });
      if(data.ok){
        console.log("Login success");
        if (email === "admin@gmail.com") {
          window.location.href="/api/admin";
          return;
        }
        else{
         window.location.href = "/api/user"; 
        }
      }
    })

    // register form intergration
    registerform.addEventListener('submit',async (e)=>{
      e.preventDefault();
      let name = document.getElementById('name-signup').value;
      let email = document.getElementById('email-signup').value;
      let password = document.getElementById('password-signup').value;

      const data = await fetch(`${api}/auth/register`,{
        method:'POST',
        headers:{
          'Content-Type':'application/json'
        },
        body:JSON.stringify({name,email,password})
      });

      if(data.ok){
        console.log('success');
        alert('register done');
      }
    })
    
  </script>

</body>
</html>
