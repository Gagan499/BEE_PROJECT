<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Customer Booking</title>
	<link rel="stylesheet" href="/assets/css/style.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Allura&display=swap" rel="stylesheet">
	<link
		href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Pontano+Sans:wght@400&display=swap"
		rel="stylesheet">
	<!-- Tailwind CSS for the header -->
	<script src="https://cdn.tailwindcss.com"></script>
	<!-- Font Awesome for the footer icons -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

	<header class="hero-section">
		<%- include('partials/navbar') %>
		<h1>My Bookings</h1>
	</header>

	<%- include('partials/alert') %>

	<main class="content-wrapper">
		<div class="booking-controls">
			<button class="new-booking-btn">New Booking</button>
			<div class="filter-controls">
				<button class="filter-btn">Filter <i class="fas fa-filter"></i></button>
				<button class="location-btn">Dubai</button>
				<button class="sort-btn">Sort <i class="fas fa-sort-up"></i><i class="fas fa-sort-down"></i></button>
			</div>
		</div>

		<div class="booking-tabs">
			<div class="tab-header">
				<button class="tab-btn active" data-tab="upcoming">Upcoming bookings</button>
				<button class="tab-btn" data-tab="past">Past bookings</button>
			</div>
		</div>

		<div class="booking-content">
			<div class="tab-content active" id="upcoming">
				<div class="booking-cards">
					<div class="booking-card">
						<div class="hotel-name">American Hotel</div>
						<div class="booking-details">
							<div class="detail-line"><strong>Name:</strong> Gagandeep Singh</div>
							<div class="detail-line"><strong>From:</strong> Dubai</div>
							<div class="detail-line"><strong>Arrival:</strong> 2025-05-05 at 11:01</div>
							<div class="detail-line"><strong>Return:</strong> 2025-05-06 at 11:01</div>
						</div>
						<button class="view-booking-btn">View this booking</button>
					</div>
				</div>
			</div>

			<div class="tab-content" id="past">
				<div class="booking-cards">
					<div class="booking-card">
						<div class="hotel-name">Grand Palace Hotel</div>
						<div class="booking-details">
							<div class="detail-line"><strong>Name:</strong> Gagandeep Singh</div>
							<div class="detail-line"><strong>From:</strong> Mumbai</div>
							<div class="detail-line"><strong>Arrival:</strong> 2025-03-15 at 10:00</div>
							<div class="detail-line"><strong>Return:</strong> 2025-03-17 at 12:00</div>
						</div>
						<button class="view-booking-btn">View this booking</button>
					</div>
				</div>
			</div>
		</div>
	</main>

	<!-- Booking Form Modal -->
	<div class="modal-overlay" id="bookingModal">
		<div class="modal-content">
			<form class="booking-form-modal" id="bookingForm">
				<div class="form-row">
					<div class="form-group">
						<label for="customerName">Name :</label>
						<input type="text" id="customerName" name="customerName" required>
					</div>
					<div class="form-group">
						<label for="phoneNumber">Phone No. :</label>
						<input type="tel" id="phoneNumber" name="phoneNumber" required>
					</div>
				</div>

				<div class="form-row">
					<div class="form-group full-width">
						<label for="emailId">Email id :</label>
						<input type="email" id="emailId" name="emailId" required>
					</div>
				</div>

				<div class="form-row">
					<div class="booking-type">
						<div class="radio-group">
							<input type="radio" id="package" name="bookingType" value="package" checked>
							<label for="package">Package</label>
						</div>
						<div class="radio-group">
							<input type="radio" id="stayOnly" name="bookingType" value="stayOnly">
							<label for="stayOnly">Stay only</label>
						</div>
					</div>
				</div>

				<div class="sliding-container">
					<div class="sliding-content" id="slidingContent">
						<div class="slide-panel active" id="packagePanel">
							<div class="form-group">
								<label for="packageName">Package Name :</label>
								<select id="packageName" name="packageName" required>
									<option value="">Select a package</option>
									<option value="Bali Exploration" selected>Bali Exploration</option>
									<option value="Paradise Gateway">Paradise Gateway</option>
								</select>
							</div>
						</div>
						<div class="slide-panel" id="hotelPanel">
							<div class="form-group">
								<label for="hotelName">Hotel :</label>
								<select id="hotelName" name="hotelName">
									<option value="">Select a hotel</option>
									<option value="Jet 2 Holiday">Jet 2 Holiday</option>
									<option value="Grand Palace Resort">Grand Palace Resort</option>
									<option value="Azure Bay Hotel">Azure Bay Hotel</option>
									<option value="Sunset Paradise Inn">Sunset Paradise Inn</option>
									<option value="Royal Crown Hotel">Royal Crown Hotel</option>
									<option value="Ocean Breeze Resort">Ocean Breeze Resort</option>
								</select>
							</div>
						</div>
					</div>
				</div>

				<div class="form-row people-section">
					<div class="form-group">
						<label>People :</label>
						<div class="people-inputs">
							<div class="people-input-group">
								<label for="adults">Adults :</label>
								<input type="number" id="adults" name="adults" value="2" min="1" required>
							</div>
							<div class="people-input-group">
								<label for="children">Children :</label>
								<input type="number" id="children" name="children" value="0" min="0">
							</div>
						</div>
					</div>
				</div>

				<div class="form-row">
					<div class="form-group">
						<label for="arrivalDate">Arrival Date :</label>
						<input type="date" id="arrivalDate" name="arrivalDate" required>
					</div>
					<div class="form-group">
						<label for="departureDate">Departure Date :</label>
						<input type="date" id="departureDate" name="departureDate" required>
					</div>
				</div>

				<div class="form-buttons">
					<button type="submit" class="submit-btn">Submit</button>
					<button type="button" class="clear-btn" id="clearBtn">Clear All</button>
				</div>
			</form>
		</div>
	</div>

	<%- include('partials/footer') %>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			// Tab switching
			const tabButtons = document.querySelectorAll('.tab-btn');
			const tabContents = document.querySelectorAll('.tab-content');

			tabButtons.forEach(button => {
				button.addEventListener('click', () => {
					const tabName = button.getAttribute('data-tab');
					tabButtons.forEach(btn => btn.classList.remove('active'));
					tabContents.forEach(tab => tab.classList.remove('active'));
					button.classList.add('active');
					document.getElementById(tabName).classList.add('active');
				});
			});

			// Booking type toggle (slide panels)
			const packageRadio = document.getElementById('package');
			const stayOnlyRadio = document.getElementById('stayOnly');
			const slidingContent = document.getElementById('slidingContent');
			const packagePanel = document.getElementById('packagePanel');
			const hotelPanel = document.getElementById('hotelPanel');
			const packageNameField = document.getElementById('packageName');
			const hotelNameField = document.getElementById('hotelName');

			window.slideToPanel = function(showPackage) {
				if (showPackage) {
					slidingContent.style.transform = 'translateX(0%)';
					packagePanel.classList.add('active');
					hotelPanel.classList.remove('active');
					packageNameField.required = true;
					hotelNameField.required = false;
					hotelNameField.value = '';
				} else {
					slidingContent.style.transform = 'translateX(-50%)';
					packagePanel.classList.remove('active');
					hotelPanel.classList.add('active');
					packageNameField.required = false;
					hotelNameField.required = true;
					packageNameField.value = '';
				}
			};

			packageRadio.addEventListener('change', () => slideToPanel(true));
			stayOnlyRadio.addEventListener('change', () => slideToPanel(false));

			slideToPanel(true); // default

			// Date validation
			const arrivalDateInput = document.getElementById('arrivalDate');
			const departureDateInput = document.getElementById('departureDate');
			
			// Set minimum date to today for arrival
			const today = new Date().toISOString().split('T')[0];
			arrivalDateInput.setAttribute('min', today);
			
			// Update departure date minimum when arrival date changes
			arrivalDateInput.addEventListener('change', function() {
				const arrivalDate = this.value;
				if (arrivalDate) {
					// Set minimum departure date to day after arrival
					const minDeparture = new Date(arrivalDate);
					minDeparture.setDate(minDeparture.getDate() + 1);
					departureDateInput.setAttribute('min', minDeparture.toISOString().split('T')[0]);
					
					// If departure date is before or equal to arrival, clear it
					if (departureDateInput.value && departureDateInput.value <= arrivalDate) {
						departureDateInput.value = '';
						if (typeof showAlert === 'function') {
							showAlert('Departure date must be after arrival date', 'warning', 3000);
						}
					}
				}
			});
			
			// Validate departure date when it changes
			departureDateInput.addEventListener('change', function() {
				const departureDate = this.value;
				const arrivalDate = arrivalDateInput.value;
				
				if (arrivalDate && departureDate && departureDate <= arrivalDate) {
					this.value = '';
					if (typeof showAlert === 'function') {
						showAlert('Departure date must be after arrival date', 'error', 3000);
					} else {
						alert('Departure date must be after arrival date');
					}
				}
			});

			// Modal logic
			const modal = document.getElementById('bookingModal');
			const newBookingBtn = document.querySelector('.new-booking-btn');
			const viewBtns = document.querySelectorAll('.view-booking-btn');
			const clearBtn = document.getElementById('clearBtn');
			const bookingForm = document.getElementById('bookingForm');

			newBookingBtn.addEventListener('click', () => {
				openModal();
				clearForm();
			});

			viewBtns.forEach(btn => {
				btn.addEventListener('click', () => openModal());
			});

			modal.addEventListener('click', e => {
				if (e.target === modal) closeModal();
			});

			bookingForm.addEventListener('submit', async e => {
				e.preventDefault();
				
				// Client-side date validation
				const arrivalDate = document.getElementById('arrivalDate').value;
				const departureDate = document.getElementById('departureDate').value;
				
				if (!arrivalDate || !departureDate) {
					if (typeof showAlert === 'function') {
						showAlert('Please select both arrival and departure dates', 'error', 3000);
					} else {
						alert('Please select both arrival and departure dates');
					}
					return;
				}
				
				const arrival = new Date(arrivalDate);
				const departure = new Date(departureDate);
				const today = new Date();
				today.setHours(0, 0, 0, 0);
				
				// Validate arrival date is not in the past
				if (arrival < today) {
					if (typeof showAlert === 'function') {
						showAlert('Arrival date cannot be in the past', 'error', 3000);
					} else {
						alert('Arrival date cannot be in the past');
					}
					return;
				}
				
				// Validate departure date is after arrival date
				if (departure <= arrival) {
					if (typeof showAlert === 'function') {
						showAlert('Departure date must be after arrival date', 'error', 3000);
					} else {
						alert('Departure date must be after arrival date');
					}
					return;
				}
				
				// Get form values
				const bookingType = document.querySelector('input[name="bookingType"]:checked').value;
				const packageName = document.getElementById('packageName').value;
				const hotelName = document.getElementById('hotelName').value;
				
				// Determine location based on booking type
				const location = bookingType === 'package' ? packageName : hotelName;
				
				// Prepare booking data
				const bookingData = {
					customerName: document.getElementById('customerName').value,
					phoneNumber: document.getElementById('phoneNumber').value,
					emailId: document.getElementById('emailId').value,
					bookingType: bookingType,
					packageName: bookingType === 'package' ? packageName : '',
					hotelName: bookingType === 'stayOnly' ? hotelName : '',
					location: location,
					arrivalDate: document.getElementById('arrivalDate').value,
					departureDate: document.getElementById('departureDate').value,
					adults: document.getElementById('adults').value,
					children: document.getElementById('children').value || '0'
				};
				
				try {
					// Submit to API
					const response = await fetch('/api/bookings', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json'
						},
						body: JSON.stringify(bookingData)
					});
					
					const result = await response.json();
					
					if (result.success) {
						if (typeof showAlert === 'function') {
							showAlert('Booking submitted successfully!', 'success', 5000);
						} else {
							alert('Booking submitted successfully!');
						}
						clearForm();
						closeModal();
						// Optionally reload the page to show the new booking
						// window.location.reload();
					} else {
						if (typeof showAlert === 'function') {
							showAlert(result.message || 'Failed to submit booking. Please try again.', 'error', 5000);
						} else {
							alert(result.message || 'Failed to submit booking. Please try again.');
						}
					}
				} catch (error) {
					console.error('Error submitting booking:', error);
					if (typeof showAlert === 'function') {
						showAlert('An error occurred while submitting your booking. Please try again.', 'error', 5000);
					} else {
						alert('An error occurred while submitting your booking. Please try again.');
					}
				}
			});

			clearBtn.addEventListener('click', clearForm);

			// Booking hover effects
			document.querySelectorAll('.booking-card').forEach(card => {
				card.addEventListener('mouseenter', () => {
					card.style.transform = 'translateY(-8px) scale(1.02)';
					card.style.boxShadow = '0 15px 35px rgba(0,0,0,0.15)';
				});
				card.addEventListener('mouseleave', () => {
					card.style.transform = 'translateY(0) scale(1)';
					card.style.boxShadow = '0 4px 15px rgba(0,0,0,0.1)';
				});
			});
		});

		function openModal() {
			const modal = document.getElementById('bookingModal');
			modal.style.display = 'flex';
			document.body.style.overflow = 'hidden';
		}

		function closeModal() {
			const modal = document.getElementById('bookingModal');
			modal.style.display = 'none';
			document.body.style.overflow = 'auto';
		}

		function clearForm() {
			const form = document.getElementById('bookingForm');
			form.reset();
			document.getElementById('adults').value = '2';
			document.getElementById('children').value = '0';
			document.getElementById('package').checked = true;
			slideToPanel(true);
			document.getElementById('packageName').value = 'Bali Exploration';
			
			// Reset date validation
			const arrivalDateInput = document.getElementById('arrivalDate');
			const departureDateInput = document.getElementById('departureDate');
			const today = new Date().toISOString().split('T')[0];
			arrivalDateInput.setAttribute('min', today);
			departureDateInput.removeAttribute('min');
		}
	</script>
</body>
</html>
