<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Customer Booking</title>
	<link rel="stylesheet" href="/assets/css/style.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

	<header class="hero-section">
		<%- include('partials/navbar') %>
		<h1>My Bookings</h1>
	</header>

	<main class="content-wrapper">
		<div class="booking-controls">
			<button class="new-booking-btn">New Booking</button>
			<div class="filter-controls">
				<button class="filter-btn">Filter <i class="fas fa-filter"></i></button>
				<button class="location-btn">Dubai</button>
				<button class="sort-btn">Sort <i class="fas fa-sort-up"></i><i class="fas fa-sort-down"></i></button>
				<button class="trips-btn">Upcoming Trips</button>
			</div>
			<div class="admin-tag">1234@gmail.com</div>
		</div>

		<div class="booking-tabs">
			<div class="tab-header">
				<button class="tab-btn active" data-tab="upcoming">Upcoming bookings</button>
				<button class="tab-btn" data-tab="past">Past bookings</button>
			</div>
		</div>

		<div class="booking-content">
			<div class="tab-content active" id="upcoming">
				<div class="booking-cards">
					<div class="booking-card">
						<div class="hotel-name">American Hotel</div>
						<div class="booking-details">
							<div class="detail-line"><strong>Name:</strong> Gagandeep Singh</div>
							<div class="detail-line"><strong>From:</strong> Dubai</div>
							<div class="detail-line"><strong>Arrival:</strong> 2025-05-05 at 11:01</div>
							<div class="detail-line"><strong>Return:</strong> 2025-05-06 at 11:01</div>
						</div>
						<button class="view-booking-btn">View this booking</button>
					</div>
				</div>
			</div>

			<div class="tab-content" id="past">
				<div class="booking-cards">
					<div class="booking-card">
						<div class="hotel-name">Grand Palace Hotel</div>
						<div class="booking-details">
							<div class="detail-line"><strong>Name:</strong> Gagandeep Singh</div>
							<div class="detail-line"><strong>From:</strong> Mumbai</div>
							<div class="detail-line"><strong>Arrival:</strong> 2025-03-15 at 10:00</div>
							<div class="detail-line"><strong>Return:</strong> 2025-03-17 at 12:00</div>
						</div>
						<button class="view-booking-btn">View this booking</button>
					</div>
				</div>
			</div>
		</div>
	</main>

	<!-- Booking Form Modal -->
	<div class="modal-overlay" id="bookingModal">
		<div class="modal-content">
			<form class="booking-form-modal" id="bookingForm">
				<div class="form-row">
					<div class="form-group">
						<label for="customerName">Name :</label>
						<input type="text" id="customerName" name="customerName" required>
					</div>
					<div class="form-group">
						<label for="phoneNumber">Phone No. :</label>
						<input type="tel" id="phoneNumber" name="phoneNumber" required>
					</div>
				</div>

				<div class="form-row">
					<div class="form-group full-width">
						<label for="emailId">Email id :</label>
						<input type="email" id="emailId" name="emailId" required>
					</div>
				</div>

				<div class="form-row">
					<div class="booking-type">
						<div class="radio-group">
							<input type="radio" id="package" name="bookingType" value="package" checked>
							<label for="package">Package</label>
						</div>
						<div class="radio-group">
							<input type="radio" id="stayOnly" name="bookingType" value="stayOnly">
							<label for="stayOnly">Stay only</label>
						</div>
					</div>
				</div>

				<div class="sliding-container">
					<div class="sliding-content" id="slidingContent">
						<div class="slide-panel active" id="packagePanel">
							<div class="form-group">
								<label for="packageName">Package Name :</label>
								<select id="packageName" name="packageName" required>
									<option value="">Select a package</option>
									<option value="Bali Exploration" selected>Bali Exploration</option>
									<option value="Paradise Gateway">Paradise Gateway</option>
								</select>
							</div>
						</div>
						<div class="slide-panel" id="hotelPanel">
							<div class="form-group">
								<label for="hotelName">Hotel :</label>
								<select id="hotelName" name="hotelName">
									<option value="">Select a hotel</option>
									<option value="Jet 2 Holiday">Jet 2 Holiday</option>
									<option value="Grand Palace Resort">Grand Palace Resort</option>
									<option value="Azure Bay Hotel">Azure Bay Hotel</option>
									<option value="Sunset Paradise Inn">Sunset Paradise Inn</option>
									<option value="Royal Crown Hotel">Royal Crown Hotel</option>
									<option value="Ocean Breeze Resort">Ocean Breeze Resort</option>
								</select>
							</div>
						</div>
					</div>
				</div>

				<div class="form-row people-section">
					<div class="form-group">
						<label>People :</label>
						<div class="people-inputs">
							<div class="people-input-group">
								<label for="adults">Adults :</label>
								<input type="number" id="adults" name="adults" value="2" min="1" required>
							</div>
							<div class="people-input-group">
								<label for="children">Children :</label>
								<input type="number" id="children" name="children" value="0" min="0">
							</div>
						</div>
					</div>
				</div>

				<div class="form-row">
					<div class="form-group">
						<label for="arrivalDate">Arrival Date :</label>
						<input type="date" id="arrivalDate" name="arrivalDate" required>
					</div>
					<div class="form-group">
						<label for="departureDate">Departure Date :</label>
						<input type="date" id="departureDate" name="departureDate" required>
					</div>
				</div>

				<div class="form-buttons">
					<button type="submit" class="submit-btn">Submit</button>
					<button type="button" class="clear-btn" id="clearBtn">Clear All</button>
				</div>
			</form>
		</div>
	</div>

	<%- include('partials/footer') %>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			// Tab switching
			const tabButtons = document.querySelectorAll('.tab-btn');
			const tabContents = document.querySelectorAll('.tab-content');

			tabButtons.forEach(button => {
				button.addEventListener('click', () => {
					const tabName = button.getAttribute('data-tab');
					tabButtons.forEach(btn => btn.classList.remove('active'));
					tabContents.forEach(tab => tab.classList.remove('active'));
					button.classList.add('active');
					document.getElementById(tabName).classList.add('active');
				});
			});

			// Booking type toggle (slide panels)
			const packageRadio = document.getElementById('package');
			const stayOnlyRadio = document.getElementById('stayOnly');
			const slidingContent = document.getElementById('slidingContent');
			const packagePanel = document.getElementById('packagePanel');
			const hotelPanel = document.getElementById('hotelPanel');
			const packageNameField = document.getElementById('packageName');
			const hotelNameField = document.getElementById('hotelName');

			window.slideToPanel = function(showPackage) {
				if (showPackage) {
					slidingContent.style.transform = 'translateX(0%)';
					packagePanel.classList.add('active');
					hotelPanel.classList.remove('active');
					packageNameField.required = true;
					hotelNameField.required = false;
					hotelNameField.value = '';
				} else {
					slidingContent.style.transform = 'translateX(-50%)';
					packagePanel.classList.remove('active');
					hotelPanel.classList.add('active');
					packageNameField.required = false;
					hotelNameField.required = true;
					packageNameField.value = '';
				}
			};

			packageRadio.addEventListener('change', () => slideToPanel(true));
			stayOnlyRadio.addEventListener('change', () => slideToPanel(false));

			slideToPanel(true); // default

			// Modal logic
			const modal = document.getElementById('bookingModal');
			const newBookingBtn = document.querySelector('.new-booking-btn');
			const viewBtns = document.querySelectorAll('.view-booking-btn');
			const clearBtn = document.getElementById('clearBtn');
			const bookingForm = document.getElementById('bookingForm');

			newBookingBtn.addEventListener('click', () => {
				openModal();
				clearForm();
			});

			viewBtns.forEach(btn => {
				btn.addEventListener('click', () => openModal());
			});

			modal.addEventListener('click', e => {
				if (e.target === modal) closeModal();
			});

			bookingForm.addEventListener('submit', e => {
				e.preventDefault();
				alert('Booking submitted successfully!');
				closeModal();
			});

			clearBtn.addEventListener('click', clearForm);

			// Booking hover effects
			document.querySelectorAll('.booking-card').forEach(card => {
				card.addEventListener('mouseenter', () => {
					card.style.transform = 'translateY(-8px) scale(1.02)';
					card.style.boxShadow = '0 15px 35px rgba(0,0,0,0.15)';
				});
				card.addEventListener('mouseleave', () => {
					card.style.transform = 'translateY(0) scale(1)';
					card.style.boxShadow = '0 4px 15px rgba(0,0,0,0.1)';
				});
			});
		});

		function openModal() {
			const modal = document.getElementById('bookingModal');
			modal.style.display = 'flex';
			document.body.style.overflow = 'hidden';
		}

		function closeModal() {
			const modal = document.getElementById('bookingModal');
			modal.style.display = 'none';
			document.body.style.overflow = 'auto';
		}

		function clearForm() {
			const form = document.getElementById('bookingForm');
			form.reset();
			document.getElementById('adults').value = '2';
			document.getElementById('children').value = '0';
			document.getElementById('package').checked = true;
			slideToPanel(true);
			document.getElementById('packageName').value = 'Bali Exploration';
		}
	</script>
</body>
</html>
