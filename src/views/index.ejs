<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Palm Ways - Luxury Resort & Spa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/assets/css/theme.css" />
    <style>
      * {
 
        margin: 0;
        padding: 0;
        box-sizing: border-box;
 }

      html {
        scroll-behavior: smooth;
 }

      body {
        font-family: "Poppins", sans-serif;
        background-color: var(--bg-primary);
        color: var(--text-primary);
        min-height: 100vh;
        overflow-x: hidden;
        /* margin-top: -60px; */
      }
    
      .teal-gradient {
        background: linear-gradient(135deg, #008080, #00cec9);
      }
      
      /* --- Hero Section --- */
      .hero-section {
        position: relative;
 height: 100vh;
        min-height: 600px;
        margin-top: 0;
        background: url('/assets/images/headerbg.jpg') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
 }

      .hero-overlay {
        position: absolute;
        top: 0;
 left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
      }

      .hero-content {
        position: relative;
 z-index: 2;
        max-width: 900px;
        padding: 2rem;
      }

      .hero-badge {
        display: inline-flex;
 align-items: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        padding: 0.6rem 1.5rem;
        border-radius: 25px;
        font-size: 0.9rem;
        margin-bottom: 2rem;
 border: 1px solid rgba(255, 255, 255, 0.2);
      }

      .hero-title {
        font-size: 4rem;
 font-weight: 700;
        margin-bottom: 1.5rem;
        line-height: 1.2;
        text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.3);
 }

      .hero-description {
        font-size: 1.25rem;
        line-height: 1.6;
 margin-bottom: 3rem;
        color: rgba(255, 255, 255, 0.95);
        text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.3);
 }

      .hero-buttons {
        display: flex;
        gap: 1.5rem;
 justify-content: center;
        flex-wrap: wrap;
      }

      .hero-btn-primary {
        /* Teal Gradient Button */
        background: linear-gradient(135deg, #008080, #00cec9);
 color: white;
        padding: 1rem 2.5rem;
        border-radius: 30px;
        font-weight: 600;
        font-size: 1.05rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
 display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
      }

      .hero-btn-primary:hover {
        transform: translateY(-3px);
 box-shadow: 0 10px 30px rgba(0, 128, 128, 0.4); /* Teal shadow */
      }

      .hero-btn-secondary {
        background: rgba(255, 255, 255, 0.15);
 backdrop-filter: blur(10px);
        color: white;
        padding: 1rem 2.5rem;
        border-radius: 30px;
        font-weight: 600;
        font-size: 1.05rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
 cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
 }

      .hero-btn-secondary:hover {
        background: rgba(255, 255, 255, 0.25);
 border-color: rgba(255, 255, 255, 0.5);
        transform: translateY(-3px);
      }

      .hero-scroll {
        position: absolute;
 bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        animation: bounce 2s infinite;
 }

      .hero-scroll i {
        font-size: 2rem;
        color: white;
 opacity: 0.7;
      }

      @keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
          transform: translateX(-50%) translateY(0);
 }
        40% {
          transform: translateX(-50%) translateY(-10px);
 }
        60% {
          transform: translateX(-50%) translateY(-5px);
 }
      }

      /* --- Feature Bar --- */
      .feature-bar {
        /* Teal Gradient */
        background: linear-gradient(135deg, #008080, #00cec9);
 padding: 2.5rem 2rem;
      }

      .feature-container {
        max-width: 1400px;
 margin: 0 auto;
        display: grid;
        /* Adjusted minmax for better responsiveness */
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
 gap: 2rem;
        text-align: center;
      }

      .feature-item {
        color: white;
 }

      .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
 }

      .feature-text {
        font-size: 1.1rem;
        font-weight: 600;
 margin: 0;
      }

      /* --- Main Content --- */
      .main-content {
        max-width: 1400px;
 margin: 0 auto;
        padding: 4rem 2rem;
      }

      /* --- Section Title --- */
      .section-header {
        text-align: center;
 margin-bottom: 3rem;
      }

      .section-icon {
        color: #008080;
 /* Primary Teal */
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
 }

      .section-title {
        color: #008080;
 /* Primary Teal */
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 2px;
        margin-bottom: 0.75rem;
 text-transform: uppercase;
      }

      .section-subtitle {
        font-size: 1.5rem;
 font-weight: 600;
        color: #1a535c; /* Dark Teal for contrast */
        margin-bottom: 0.75rem;
 }

      .section-description {
        color: #6c757d;
        font-size: 1.05rem;
 max-width: 900px;
        margin: 0 auto;
      }

      /* --- Amenities Grid --- */
      .amenities-grid {
        display: grid;
 /* Adjusted minmax for better responsiveness */
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); 
        gap: 2rem;
 margin-top: 3rem;
      }

      .amenity-card {
        background: var(--bg-secondary);
        border-radius: 15px;
        padding: 2rem 1.5rem;
        text-align: center;
        box-shadow: 0 2px 15px var(--shadow-light);
        transition: all 0.3s ease;
 }

      .amenity-card:hover {
        transform: translateY(-8px);
 box-shadow: 0 8px 30px var(--shadow-medium);
      }

      .amenity-icon-circle {
        width: 80px;
 height: 80px;
        background: var(--light-mint);
        border-radius: 20px;
        display: flex;
 align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
      }
      
      .dark .amenity-icon-circle {
        background: var(--bg-tertiary);
      }

      .amenity-icon {
        font-size: 2rem;
 color: #008080; /* Primary Teal */
      }

      .amenity-title {
        font-size: 1.15rem;
 font-weight: 600;
        color: #1a535c; /* Dark Teal for contrast */
        margin-bottom: 0.5rem;
 }

      .amenity-description {
        color: #6c757d;
        font-size: 0.95rem;
 line-height: 1.5;
      }

      /* --- Rooms Section --- */
      .rooms-section {
        background: var(--bg-secondary);
        padding: 4rem 2rem;
        margin-top: 4rem;
      }

      .rooms-grid {
        display: grid;
 /* Adjusted minmax for better responsiveness */
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
        gap: 2.5rem;
 max-width: 1400px;
        margin: 0 auto;
      }

      .room-card {
        background: var(--bg-secondary);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 20px var(--shadow-light);
        transition: all 0.3s ease;
 }

      .room-card:hover {
        transform: translateY(-10px);
 box-shadow: 0 12px 40px var(--shadow-medium);
      }

      .room-image {
        width: 100%;
 height: 250px;
        object-fit: cover;
        position: relative;
      }

      .room-price {
        position: absolute;
 top: 1rem;
        right: 1rem;
        background: var(--bg-secondary);
        padding: 0.5rem 1.25rem;
        border-radius: 25px;
        font-weight: 600;
        color: var(--text-primary);
        box-shadow: 0 2px 10px var(--shadow-light);
 }

      .room-price span {
        color: #008080;
 /* Primary Teal */
        font-size: 1.25rem;
 }

      .room-details {
        padding: 1.75rem;
 }

      .room-name {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 1rem;
      }

      .room-features {
        display: flex;
 flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
      }

      .room-feature {
        display: inline-flex;
 align-items: center;
        gap: 0.25rem;
        padding: 0.4rem 0.85rem;
        background: #e6f7f7; /* Light Teal/Mint background */
        color: #008080;
 /* Primary Teal */
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
 }

      .book-btn {
        width: 100%;
 /* Teal Gradient Button */
        background: linear-gradient(135deg, #008080, #00cec9);
        color: white;
        border: none;
 padding: 0.9rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
 }

      .book-btn:hover {
        transform: translateY(-2px);
 box-shadow: 0 6px 20px rgba(0, 128, 128, 0.3); /* Teal shadow */
      }

      /* --- Contact Section --- */
      .contact-section {
        background: linear-gradient(135deg, var(--bg-primary), var(--bg-tertiary));
        padding: 4rem 2rem;
        margin-top: 4rem;
      }

      .contact-container {
        max-width: 1200px;
 margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1.5fr; /* Desktop layout */
        gap: 4rem;
 align-items: start;
      }

      .contact-info h3 {
        color: #00bfff;
 /* Blue-Teal Accent */
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 2px;
        margin-bottom: 1.5rem;
 }

      .contact-info h2 {
        font-size: 1.15rem;
        font-weight: 500;
 color: #1a535c; /* Dark Teal */
        margin-bottom: 2rem;
        line-height: 1.6;
 }

      .contact-detail {
        display: flex;
        align-items: center;
 gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .contact-icon-circle {
        width: 50px;
 height: 50px;
        /* Teal-Blue Gradient */
        background: linear-gradient(135deg, #00bfff, #008080);
        border-radius: 10px;
 display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
        flex-shrink: 0;
 }

      .contact-text h4 {
        font-size: 0.95rem;
        font-weight: 600;
 color: #1a535c; /* Dark Teal */
        margin-bottom: 0.25rem;
 }

      .contact-text p {
        color: #6c757d;
        font-size: 0.9rem;
 margin: 0;
      }

      /* --- Contact Form --- */
      .contact-form-container {
        background: white;
 padding: 2.5rem;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      }

      .contact-form-container h3 {
        font-size: 1.5rem;
 font-weight: 600;
        color: #1a535c; /* Dark Teal */
        margin-bottom: 2rem;
 }

      .form-group {
        margin-bottom: 1.5rem;
 }

      .form-group label {
        display: block;
        font-size: 0.85rem;
 font-weight: 600;
        color: #6c757d;
        margin-bottom: 0.5rem;
        letter-spacing: 0.5px;
      }

      .form-group input,
      .form-group textarea {
        width: 100%;
 padding: 0.9rem 1rem;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        font-size: 0.95rem;
        font-family: "Poppins", sans-serif;
        transition: all 0.3s ease;
 }

      .form-group input:focus,
      .form-group textarea:focus {
        outline: none;
 border-color: #00bfff; /* Blue-Teal focus */
        box-shadow: 0 0 0 3px rgba(0, 191, 255, 0.1);
 }

      .form-group textarea {
        resize: vertical;
        min-height: 120px;
 }

      .form-group input::placeholder,
      .form-group textarea::placeholder {
        color: #adb5bd;
 }

      .submit-btn {
        /* Teal-Blue Gradient */
        background: linear-gradient(135deg, #00bfff, #008080);
 color: white;
        border: none;
        padding: 1rem 2.5rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
 display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .submit-btn:hover {
        transform: translateY(-2px);
 box-shadow: 0 6px 20px rgba(0, 191, 255, 0.3);
      }

      /* --- Help Button --- */
      .help-button {
        position: fixed;
 bottom: 2rem;
        right: 2rem;
        width: 50px;
        height: 50px;
        background: #1a535c;
 /* Dark Teal */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
 color: white;
        font-size: 1.25rem;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
        z-index: 999;
 }

      .help-button:hover {
        transform: scale(1.1);
        background: #0d292f;
 /* Even darker Teal */
      }

      /* --- Mobile Responsive (max-width: 768px) --- */
      @media (max-width: 768px) {
        .header-container {
          padding: 1rem;
 }

        nav ul {
          display: none;
 }

        .hero-section {
          height: 80vh;
 min-height: 500px;
        }

        .hero-title {
          font-size: 2.5rem;
 }

        .hero-description {
          font-size: 1.05rem;
 }

        .hero-buttons {
          flex-direction: column;
 gap: 1rem;
        }

        .hero-btn-primary,
        .hero-btn-secondary {
          width: 100%;
 max-width: 300px;
          margin-left: auto; /* Center items when stacked */
          margin-right: auto;
 }

        .feature-container {
          grid-template-columns: 1fr;
 gap: 1.5rem;
        }

        .amenities-grid {
          grid-template-columns: 1fr;
 gap: 1.5rem;
        }

        .rooms-grid {
          grid-template-columns: 1fr;
 gap: 2rem;
        }

        .contact-container {
          grid-template-columns: 1fr;
 gap: 2rem;
        }

        .main-content {
          padding: 2rem 1rem;
 }

        .section-subtitle {
          font-size: 1.25rem;
 }
      }

      /* --- Mobile Responsive (max-width: 480px) --- */
      @media (max-width: 480px) {
        .header-container {
          padding: 0.75rem;
 }

        .hero-section {
          height: 85vh;
 min-height: 400px;
          margin-top: 0px;
          padding: 1rem;
        }

        .hero-content {
          padding: 1rem;
 }

        .hero-badge {
          padding: 0.5rem 1rem;
 font-size: 0.75rem;
          margin-bottom: 1rem;
        }

        .hero-title {
          font-size: 1.75rem;
 margin-bottom: 1rem;
          line-height: 1.3;
        }

        .hero-description {
          font-size: 0.9rem;
 margin-bottom: 2rem;
          line-height: 1.5;
        }

        .hero-buttons {
          flex-direction: column;
 gap: 0.75rem;
          width: 100%;
        }

        .hero-btn-primary,
        .hero-btn-secondary {
          width: 100%;
 max-width: 100%;
          padding: 0.85rem 1.5rem;
          font-size: 0.95rem;
          flex: 1;
          justify-content: center;
 }

        .hero-scroll {
          bottom: 1rem;
 }

        .hero-scroll i {
          font-size: 1.5rem;
 }

        .feature-bar {
          padding: 1.5rem 1rem;
 }

        .feature-container {
          grid-template-columns: 1fr;
 gap: 1.25rem;
        }

        .feature-icon {
          font-size: 2rem;
 margin-bottom: 0.5rem;
        }

        .feature-text {
          font-size: 0.95rem;
 }

        .main-content {
          padding: 2rem 1rem;
 }

        .section-header {
          margin-bottom: 2rem;
 }

        .section-icon {
          font-size: 1.25rem;
 }

        .section-title {
          font-size: 0.8rem;
 margin-bottom: 0.5rem;
        }

        .section-subtitle {
          font-size: 1.1rem;
 margin-bottom: 0.5rem;
        }

        .section-description {
          font-size: 0.9rem;
 }

        .amenities-grid {
          grid-template-columns: 1fr;
 gap: 1.25rem;
          margin-top: 2rem;
        }

        .amenity-card {
          padding: 1.5rem 1rem;
 }

        .amenity-icon-circle {
          width: 60px;
 height: 60px;
          margin-bottom: 1rem;
        }

        .amenity-icon {
          font-size: 1.5rem;
 }

        .amenity-title {
          font-size: 1rem;
 }

        .amenity-description {
          font-size: 0.85rem;
 }

        .rooms-section {
          padding: 2rem 1rem;
 margin-top: 2rem;
        }

        .rooms-grid {
          grid-template-columns: 1fr;
 gap: 1.5rem;
        }

        .room-image {
          height: 200px;
 }

        .room-price {
          top: 0.75rem;
 right: 0.75rem;
          padding: 0.4rem 1rem;
          font-size: 0.85rem;
        }

        .room-price span {
          font-size: 1.1rem;
 }

        .room-details {
          padding: 1.25rem;
 }

        .room-name {
          font-size: 1.1rem;
 margin-bottom: 0.75rem;
        }

        .room-features {
          gap: 0.5rem;
 margin-bottom: 1rem;
        }

        .room-feature {
          padding: 0.35rem 0.7rem;
 font-size: 0.75rem;
        }

        .book-btn {
          padding: 0.75rem 1.5rem;
 font-size: 0.9rem;
        }

        .contact-section {
          padding: 2rem 1rem;
 margin-top: 2rem;
        }

        .contact-container {
          grid-template-columns: 1fr;
 gap: 1.5rem;
        }

        .contact-info h3 {
          font-size: 0.85rem;
 margin-bottom: 1rem;
        }

        .contact-info h2 {
          font-size: 1rem;
 margin-bottom: 1.5rem;
          line-height: 1.5;
        }

        .contact-detail {
          margin-bottom: 1.25rem;
 }

        .contact-icon-circle {
          width: 45px;
 height: 45px;
          font-size: 1.1rem;
        }

        .contact-text h4 {
          font-size: 0.9rem;
 }

        .contact-text p {
          font-size: 0.85rem;
 }

        .contact-form-container {
          padding: 1.5rem;
 }

        .contact-form-container h3 {
          font-size: 1.25rem;
 margin-bottom: 1.5rem;
        }

        .form-group {
          margin-bottom: 1.25rem;
 }

        .form-group label {
          font-size: 0.8rem;
 margin-bottom: 0.4rem;
        }

        .form-group input,
        .form-group textarea {
          padding: 0.75rem 0.85rem;
 font-size: 0.9rem;
        }

        .form-group textarea {
          min-height: 100px;
 }

        .submit-btn {
          padding: 0.85rem 2rem;
 font-size: 0.9rem;
          width: 100%;
          justify-content: center;
        }

        .help-button {
          width: 45px;
 height: 45px;
          bottom: 1.5rem;
          right: 1.5rem;
          font-size: 1.1rem;
        }
      }
    </style>
  </head>

