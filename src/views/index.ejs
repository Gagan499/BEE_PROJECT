                style="display: none"
              ></div>
            </div>
          </div>
        </section>
      </div>
      <%- include('partials/footer') %>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const canvas = document.getElementById("cardCanvas");
        const ctx = canvas.getContext("2d");

        let width, height;

        // --- Configuration ---
        const imageSources = [
          "assets/images/carousel/bali.png",
          "assets/images/carousel/jaipur.png",
          "assets/images/carousel/la.png",
          "assets/images/carousel/maldives.png",
          "assets/images/carousel/switzerland.png",
        ];
        const locationNames = [
          "Bali",
          "Jaipur",
          "Los Angeles",
          "Maldives",
          "Switzerland",
        ];
        const images = [];
        let imagesLoaded = 0;

        const CARD_ASPECT_RATIO = 1.5;
        const CARD_WIDTH_RATIO = 0.15;
        const CARD_SPACING_RATIO = 0.05;
        const ACTIVE_SCALE = 1.1;
        const INACTIVE_SCALE = 0.85;
        const ANIMATION_SPEED = 0.07;
        const LOOP_ANIMATION_SPEED = 0.14;

        let cards = [];
        let currentIndex = 0;
        let prevIndex = 0;
        let displayOrder = [];
        let isAnimating = false;
        let loopingCardIndex = -1;
        let bgFade = 1; // 1 = fully current, 0 = fully previous
        let bgFading = false;

        function preloadImages() {
          for (let i = 0; i < imageSources.length; i++) {
            images[i] = new Image();
            images[i].onload = () => {
              imagesLoaded++;
              if (imagesLoaded === imageSources.length) init();
            };
            images[i].onerror = () => {
              console.error(`Failed to load image: ${imageSources[i]}`);
              imagesLoaded++;
              if (imagesLoaded === imageSources.length) init();
            };
            images[i].src = imageSources[i];
          }
        }

        function setup() {
          const heroContainer = document.querySelector(".hero-container");
          width = canvas.width = heroContainer.offsetWidth;
          height = canvas.height = heroContainer.offsetHeight;

          displayOrder = images.map((_, i) => i);
          const centerDisplayIndex = Math.floor(displayOrder.length / 2);
          currentIndex = displayOrder[centerDisplayIndex];

          cards = images.map((img) => ({
            img,
            targetX: 0,
            x: 0,
            y: 0,
            width: 0,
            height: 0,
            targetScale: 0,
            scale: 0,
            targetAlpha: 0,
            alpha: 0,
          }));

          updateCardPositions(false);
          updateLocationLabel();
        }

        function init() {
          setup();
          animate();
          window.addEventListener("resize", setup);
          canvas.addEventListener("click", handleClick); // Listen on canvas
        }

        function handleClick() {
          triggerAnimation();
        }

        function triggerAnimation() {
          isAnimating = true;
          loopingCardIndex = displayOrder[0];
          displayOrder.push(displayOrder.shift());
          const centerDisplayIndex = Math.floor(displayOrder.length / 2);
          prevIndex = currentIndex;
          currentIndex = displayOrder[centerDisplayIndex];
          bgFade = 0;
          bgFading = true;
          updateCardPositions(true);
          updateLocationLabel();
        }
        // Update the location label below the carousel
        function updateLocationLabel() {
          const label = document.getElementById("carousel-location-label");
          if (!label) return;
          // Find the center card's location name
          const centerDisplayIndex = Math.floor(displayOrder.length / 2);
          const centerCardIdx = displayOrder[centerDisplayIndex];
          label.textContent = locationNames[centerCardIdx] || "";
        }

        function updateCardPositions(animate = true) {
          const cardWidth = width * CARD_WIDTH_RATIO;
          const cardHeight = cardWidth * CARD_ASPECT_RATIO;
          const cardSpacing = width * CARD_SPACING_RATIO;
          const centerPosX = width / 2 - cardWidth / 2;
          const centerDisplayIndex = Math.floor(displayOrder.length / 2);

          displayOrder.forEach((cardIndex, displayIndex) => {
            const card = cards[cardIndex];
            const offset = displayIndex - centerDisplayIndex;
            const isCenter = displayIndex === centerDisplayIndex;

            card.targetX = centerPosX + offset * (cardWidth + cardSpacing);
            card.y = height / 2 - cardHeight / 2;
            card.width = cardWidth;
            card.height = cardHeight;
            card.targetScale = isCenter ? ACTIVE_SCALE : INACTIVE_SCALE;
            card.targetAlpha = isCenter ? 1.0 : 0.7;

            if (!animate) {
              card.x = card.targetX;
              card.scale = card.targetScale;
              card.alpha = card.targetAlpha;
            }
          });
        }

        function draw() {
          ctx.clearRect(0, 0, width, height);
          drawBackground();
          cards.forEach((card, index) => {
            const speed =
              index === loopingCardIndex
                ? LOOP_ANIMATION_SPEED
                : ANIMATION_SPEED;
            card.x += (card.targetX - card.x) * speed;
            card.scale += (card.targetScale - card.scale) * speed;
            card.alpha += (card.targetAlpha - card.alpha) * speed;
            drawCard(card);
          });
        }

        function drawCard(card) {
          ctx.save();
          const cardCenterX = card.x + card.width / 2;
          const cardCenterY = card.y + card.height / 2;
          ctx.translate(cardCenterX, cardCenterY);
          ctx.scale(card.scale, card.scale);
          ctx.translate(-cardCenterX, -cardCenterY);
          ctx.globalAlpha = card.alpha;
          ctx.shadowColor = "rgba(0, 0, 0, 0.4)";
          ctx.shadowBlur = 25 * card.scale;
          ctx.shadowOffsetY = 10 * card.scale;

          const cornerRadius = 30; // Matched to original CSS
          ctx.beginPath();
          ctx.moveTo(card.x + cornerRadius, card.y);
          ctx.lineTo(card.x + card.width - cornerRadius, card.y);
          ctx.quadraticCurveTo(
            card.x + card.width,
            card.y,
            card.x + card.width,
            card.y + cornerRadius
          );
          ctx.lineTo(card.x + card.width, card.y + card.height - cornerRadius);
          ctx.quadraticCurveTo(
            card.x + card.width,
            card.y + card.height,
            card.x + card.width - cornerRadius,
            card.y + card.height
          );
          ctx.lineTo(card.x + cornerRadius, card.y + card.height);
          ctx.quadraticCurveTo(
            card.x,
            card.y + card.height,
            card.x,
            card.y + card.height - cornerRadius
          );
          ctx.lineTo(card.x, card.y + cornerRadius);
          ctx.quadraticCurveTo(card.x, card.y, card.x + cornerRadius, card.y);
          ctx.closePath();
          ctx.clip();

          // Draw image: always scale image height to card height, crop width if needed
          if (card.img && card.img.complete && card.img.naturalHeight !== 0) {
            const scale = card.height / card.img.height;
            const drawWidth = card.img.width * scale;
            const sx = Math.max(0, (drawWidth - card.width) / 2 / scale);
            const sw = card.width / scale;
            ctx.drawImage(
              card.img,
              sx,
              0,
              sw,
              card.img.height,
              card.x,
              card.y,
              card.width,
              card.height
            );
          }
          ctx.restore();
        }

        function drawBackground() {
          // Fade between prevIndex and currentIndex
          const currImg = images[currentIndex];
          const prevImg = images[prevIndex];
          if (!currImg || !currImg.complete || currImg.naturalHeight === 0)
            return;

          // Helper to draw a bg image with given alpha (no overlay)
          function drawBgImage(img, alpha) {
            if (!img || !img.complete || img.naturalHeight === 0) return;
            const imgAspectRatio = img.width / img.height;
            const canvasAspectRatio = width / height;
            let drawWidth, drawHeight, drawX, drawY;
            if (imgAspectRatio > canvasAspectRatio) {
              drawHeight = height;
              drawWidth = drawHeight * imgAspectRatio;
              drawX = (width - drawWidth) / 2;
              drawY = 0;
            } else {
              drawWidth = width;
              drawHeight = drawWidth / imgAspectRatio;
              drawX = 0;
              drawY = (height - drawHeight) / 2;
            }
            ctx.save();
            ctx.globalAlpha = alpha;
            ctx.drawImage(img, drawX, drawY, drawWidth, drawHeight);
            ctx.restore();
          }

          if (bgFading && prevIndex !== currentIndex) {
            drawBgImage(prevImg, 1 - bgFade);
            drawBgImage(currImg, bgFade);
          } else {
            drawBgImage(currImg, 1);
          }
          // Always draw the dark overlay at full opacity on top
          ctx.save();
          ctx.globalAlpha = 1;
          ctx.fillStyle = "rgba(0, 0, 0, 0.64)";
          ctx.fillRect(0, 0, width, height);
          ctx.restore();
        }

        function checkAnimationComplete() {
          // Animate background fade
          if (bgFading) {
            bgFade += 0.08; // Fade speed
            if (bgFade >= 1) {
              bgFade = 1;
              bgFading = false;
              prevIndex = currentIndex;
            }
          }
          if (!isAnimating) return;
          let allCardsInPosition = true;
          for (const card of cards) {
            if (
              Math.abs(card.x - card.targetX) > 1 ||
              Math.abs(card.scale - card.targetScale) > 0.01
            ) {
              allCardsInPosition = false;
              break;
            }
          }
          if (allCardsInPosition) {
            cards.forEach((card) => {
              card.x = card.targetX;
              card.scale = card.targetScale;
              card.alpha = card.targetAlpha;
            });
            isAnimating = false;
            loopingCardIndex = -1;
          }
        }

        function animate() {
          draw();
          checkAnimationComplete();
          requestAnimationFrame(animate);
        }

        preloadImages();
      });
      
      // Contact Form Handler
      document.addEventListener("DOMContentLoaded", () => {
        const contactForm = document.getElementById("contactForm");
        const contactFormMessage =
          document.getElementById("contactFormMessage");

        if (contactForm) {
          contactForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const name = document.getElementById("contactName").value;
            const email = document.getElementById("contactEmail").value;
            const message = document.getElementById("contactMessage").value;

            // Show loading state
            const submitButton = contactForm.querySelector(
              'button[type="submit"]'
            );
            const originalText = submitButton.innerHTML;
            submitButton.innerHTML =
              '<span class="button-text">Sending...</span>';
            submitButton.disabled = true;

            // Simulate form submission (you can replace this with actual API call)
            setTimeout(() => {
              contactFormMessage.style.display = "block";
              contactFormMessage.style.color = "#25a85c";
              contactFormMessage.style.fontSize = "1.1rem";
              contactFormMessage.textContent = `Thank you, ${name}! Your message has been received. We'll get back to you at ${email} soon.`;

              // Reset form
              contactForm.reset();
              submitButton.innerHTML = originalText;
              submitButton.disabled = false;

              // Hide message after 5 seconds
              setTimeout(() => {
                contactFormMessage.style.display = "none";
              }, 5000);
            }, 1000);
          });
        }
      });
    </script>
  </body>
</html>
