                <label for="message">Message *</label>
                <textarea id="message" name="message" placeholder="Tell us how we can help you..." required></textarea>
     
              </div>

              <button type="submit" class="submit-btn">
                <i class="fas fa-paper-plane"></i>
                Send Message
