<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ThePalmWay - Travel Booking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Allura&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Pontano+Sans:wght@400&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <style>
      #carousel-location-label {
        font-family: "Allura", cursive !important;
        font-size: 4rem !important;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: "Poppins", sans-serif;
        background-color: #1f212d;
        /* Set a base background color */
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* Hero Section Container */
      .hero-container {
        position: relative;
        width: 100%;
        height: 100vh;
        /* Make hero section fill the viewport height */
        min-height: 800px;
        /* Remove default margin and add minimal padding if needed */
        margin-top: 0 !important;
        padding-top: 0 !important;
      }

      /* Canvas Styling */
      #cardCanvas {
        display: block;
        cursor: pointer;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        /* Behind the header */
      }

      /* --- MODIFIED HEADER CSS --- */
      /* Header needs to be on top of the canvas AND the rest of the page */
      header {
        position: fixed; /* Changed from 'absolute' to 'fixed' */
        top: 0;
        left: 0;
        width: 100%;
        z-index: 50; /* Increased z-index to stay on top of all content */
      }

      .lower-section {
        position: relative;
        background: linear-gradient(
          to top,
          #1f212d 15.385%,
          #2d2f3e 75%,
          #262836
        );
        padding: 100px 5%;
        color: white;
      }
      .hero-container {
        position: relative;
        width: 100%;
        height: 100vh;
        min-height: 800px;
        margin-top: 0 !important;
      }

      .section-split {
        display: flex;
        justify-content: space-around;
        align-items: center;
        border-bottom: 1px solid white;
        padding-bottom: 80px;
        margin-bottom: 80px;
        text-align: center;
        flex-wrap: wrap;
        gap: 2rem;
      }

      .split-column {
        width: 45%;
        min-width: 280px;
      }

      .section-title {
        font-weight: 500;
        font-size: 2rem;
        margin-bottom: 1.5rem;
      }

      .green-button {
        background: #25a85c;
        border-radius: 127px;
        padding: 0.9rem 2.2rem;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        transition: background 0.2s;
      }

      .green-button:hover {
        background: #1e864a;
      }

      .button-text {
        font-weight: 700;
        font-size: 1.5rem;
        color: white;
      }

      .browse-text {
        font-weight: 500;
        font-size: 2rem;
        text-align: center;
        margin-bottom: 2.5rem;
      }

      /* Package Section */
      .package-section {
        background: #64818c;
        border-radius: 41px;
        padding: 50px;
        display: flex;
        align-items: center;
        gap: 50px;
        margin-bottom: 80px;
        flex-wrap: wrap;
      }

      .package-image {
        flex: 1 1 40%;
        min-width: 280px;
        height: 320px;
        border-radius: 1.5rem;
        background-size: cover;
        background-position: center;
        background-image: url("assets/images/carousel/bali.png");
      }

      .package-details {
        flex: 1 1 50%;
        min-width: 280px;
        color: white;
      }

      @media (max-width: 768px) {
        .hero-container {
          min-height: 600px;
        }

        #carousel-location-label {
          font-size: 2.5rem !important;
          bottom: 1rem;
        }

        .lower-section {
          padding: 60px 3%;
        }

        .section-split {
          flex-direction: column;
          padding-bottom: 40px;
          margin-bottom: 40px;
        }

        .split-column {
          width: 100%;
        }

        .section-title {
          font-size: 1.5rem;
        }

        .button-text {
          font-size: 1.2rem;
        }

        .browse-text {
          font-size: 1.5rem;
        }

        .package-section {
          flex-direction: column;
          padding: 30px 20px;
          gap: 30px;
          margin-bottom: 40px;
        }

        .package-image {
          width: 100%;
          height: 250px;
        }

        .package-details {
          width: 100%;
        }

        .package-title {
          font-size: 1.3rem;
        }

        .package-description {
          font-size: 1rem;
        }
      }

      @media (max-width: 480px) {
        .hero-container {
          min-height: 500px;
        }

        #carousel-location-label {
          font-size: 2rem !important;
          padding: 0.5rem 1rem;
        }

        .lower-section {
          padding: 40px 2%;
        }

        .section-title {
          font-size: 1.2rem;
        }

        .button-text {
          font-size: 1rem;
        }

        .browse-text {
          font-size: 1.2rem;
          margin-bottom: 1.5rem;
        }

        .package-section {
          padding: 20px 15px;
          border-radius: 20px;
        }

        .package-image {
          height: 200px;
        }

        .package-title {
          font-size: 1.1rem;
        }

        .package-duration {
          font-size: 0.9rem;
        }

        .package-description {
          font-size: 0.9rem;
        }

        .explore-button {
          font-size: 1.1rem;
          padding: 0.6rem 1.5rem;
        }
      }

      .package-title {
        font-weight: 600;
        font-size: 1.5rem;
      }

      .package-duration {
        font-weight: 400;
        font-size: 1rem;
        margin-bottom: 0.7rem;
      }

      .package-description {
        font-size: 1.1rem;
        line-height: 1.5;
        margin-bottom: 1.2rem;
      }

      .explore-button {
        background: #25a85c;
        border-radius: 127px;
        padding: 0.7rem 2rem;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        font-weight: 700;
        font-size: 1.3rem;
        color: white;
        transition: background 0.2s;
      }

      .explore-button:hover {
        background: #1e864a;
      }

      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body>
    <div class="page-container">
