            </div>

            <div class="mt-12 min-w-[300px] flex-1 basis-[50%] lg:mt-0">
              <h2 class="mb-10 text-[2.75rem] font-bold text-white">
                Contact Us
              </h2>

              <form id="contactFormNew" class="flex flex-col gap-6">
                <div class="flex flex-col">
                  <label
                    for="contactNameNew"
