                  <textarea
                    id="contactMessageNew"
                    name="message"
                    class="w-full resize-y rounded-lg border-0 bg-black/20 p-4 text-base text-white placeholder-gray-400 focus:bg-black/30 focus:outline-none focus:ring-2 focus:ring-[#5568FE]"
