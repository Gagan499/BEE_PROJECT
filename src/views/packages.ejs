<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>More Packages - ThePalmWay</title>
	<link rel="stylesheet" href="/assets/css/packages.css">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Allura&display=swap" rel="stylesheet">
	<link
		href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Pontano+Sans:wght@400&display=swap"
		rel="stylesheet">
	<!-- Tailwind CSS for the header -->
	<script src="https://cdn.tailwindcss.com"></script>
	<!-- Font Awesome for the footer icons -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
	<!-- Hero Section -->
	<header class="hero-section">
		<%- include('partials/navbar') %>
		<h1>More Packages</h1>
	</header>

	<!-- Packages Section -->
	<div class="packages-rows-container">
		<% for(let i = 0; i < packages.length; i += 2) { %>
			<div class="packages-row">
				<% for(let j = i; j < i + 2 && j < packages.length; j++) { %>
					<div class="package-card" onclick="toggleCardClick(this)">
						<img src="<%= packages[j].img %>" alt="<%= packages[j].title %>" class="package-img">
						<div class="package-content">
							<h3 class="package-title"><%= packages[j].title %></h3>
							<div class="package-days">
								<span><strong><%= packages[j].days %> Days</strong> / <%= packages[j].nights %> Nights</span>
							</div>
							<p class="package-desc"><%= packages[j].desc %></p>
						</div>
					</div>
				<% } %>
			</div>
		<% } %>
	</div>

	<!-- Footer -->
	<div>
	<%- include('partials/footer') %>
</div>
	<!-- Scripts -->
	<script>
		function toggleCardClick(card) {
			card.classList.toggle('clicked');
		}

		document.addEventListener('DOMContentLoaded', () => {
			const heroSection = document.querySelector('.hero-section');
			const heroTitle = document.querySelector('.hero-section h1');
			const heroNav = document.querySelector('.hero-section nav');
			let ticking = false;

			function updateParallax() {
				const scrolled = window.pageYOffset;
				const heroRect = heroSection.getBoundingClientRect();
				const heroHeight = heroSection.offsetHeight;
				const windowHeight = window.innerHeight;
				const scrollProgress = Math.min(scrolled / (heroHeight + windowHeight * 0.5), 1);

				if (heroRect.top < windowHeight && heroRect.bottom > -heroHeight) {
					const backgroundRate = scrolled * 0.6;
					const maxMovement = heroHeight * 0.8;
					const clampedRate = Math.max(-maxMovement, Math.min(maxMovement, backgroundRate));
					const scale = 1 + (scrollProgress * 0.1);
					const rotation = scrollProgress * 1;

					heroSection.style.transition = 'none';
					heroSection.style.transform = `translateY(${clampedRate}px) scale(${scale}) rotate(${rotation}deg)`;

					if (heroTitle) {
						const titleRate = scrolled * -0.2;
						const titleOpacity = Math.max(0, 1 - scrollProgress * 1.5);
						const titleScale = Math.max(0.8, 1 - scrollProgress * 0.2);
						heroTitle.style.transform = `translateY(${titleRate}px) scale(${titleScale})`;
						heroTitle.style.opacity = titleOpacity;
					}

					if (heroNav) {
						const navRate = scrolled * -0.1;
						const navOpacity = Math.max(0.3, 1 - scrollProgress * 0.8);
						heroNav.style.transform = `translateY(${navRate}px)`;
						heroNav.style.opacity = navOpacity;
					}

				} else if (heroRect.bottom <= -heroHeight) {
					const finalRate = heroHeight * 0.8;
					const finalScale = 1.1;
					const finalRotation = 1;
					heroSection.style.transform = `translateY(${finalRate}px) scale(${finalScale}) rotate(${finalRotation}deg)`;

					if (heroTitle) {
						heroTitle.style.opacity = 0;
						heroTitle.style.transform = 'translateY(-100px) scale(0.8)';
					}

					if (heroNav) {
						heroNav.style.opacity = 0.3;
						heroNav.style.transform = 'translateY(-50px)';
					}
				}
				ticking = false;
			}

			function requestTick() {
				if (!ticking) {
					requestAnimationFrame(updateParallax);
					ticking = true;
				}
			}

			window.addEventListener('scroll', requestTick);

			// Sidebar menu functionality (optional if elements exist)
			const menuBtn = document.getElementById('menuBtn');
			const sideMenu = document.getElementById('sideMenu');
			const closeBtn = document.getElementById('closeBtn');
			const overlay = document.getElementById('overlay');

			if (menuBtn && sideMenu && closeBtn && overlay) {
				menuBtn.addEventListener('click', () => {
					sideMenu.style.transform = 'translateX(0)';
					overlay.style.display = 'block';
				});
				closeBtn.addEventListener('click', () => {
					sideMenu.style.transform = 'translateX(100%)';
					overlay.style.display = 'none';
				});
				overlay.addEventListener('click', () => {
					sideMenu.style.transform = 'translateX(100%)';
					overlay.style.display = 'none';
				});
			}
		});
	</script>
</body>
</html>
