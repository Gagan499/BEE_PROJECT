<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Curated Packages - Palm Ways</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<script src="https://cdn.tailwindcss.com"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
	<script>
		tailwind.config = {
			darkMode: 'class',
			theme: {
				extend: {
					fontFamily: {
						'poppins': ['Poppins', 'sans-serif']
					},
					colors: {
						'primary-teal': '#008080',
						'secondary-teal': '#00cec9',
						'dark-teal': '#1a535c',
						'light-mint': '#e6f7f7',
						'accent-blue': '#00bfff',
					}
				}
			}
		}
	</script>
	<link rel="stylesheet" href="/assets/css/packages.css">
</head>
<body class="font-poppins bg-gray-50 dark:bg-gray-900 dark:text-white overflow-x-hidden transparent-navbar transition-colors duration-300">
	<%- include('partials/navbar') %>

	<section class="py-32 px-8 text-white text-center relative overflow-hidden">
		<div class="absolute inset-0 z-0" style="background: url('/assets/images/headerbg.jpg') no-repeat center; background-size: cover;"></div>
		<div class="relative z-10 max-w-4xl mx-auto">
			<div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-lg px-5 py-2 rounded-full text-sm mb-6">
				<i class="fas fa-sparkles"></i>
				<span>🎉 Exclusive Offers · Save up to 30%</span>
			</div>
			<h1 class="text-5xl md:text-6xl font-bold mb-4">Curated Packages</h1>
			<p class="text-lg md:text-xl opacity-95 leading-relaxed">Discover our handcrafted vacation packages designed to create unforgettable experiences</p>
		</div>
	</section>

	<section class="bg-white dark:bg-gray-800 py-12 px-8 shadow-sm transition-colors duration-300">
		<div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 text-center">
			<div>
				<h3 class="text-4xl font-bold text-primary-teal mb-2">10,000+</h3>
				<p class="text-gray-600 dark:text-gray-300 text-sm font-medium">Happy Guests</p>
			</div>
			<div>
				<h3 class="text-4xl font-bold text-primary-teal mb-2">50+</h3>
				<p class="text-gray-600 dark:text-gray-300 text-sm font-medium">Destinations</p>
			</div>
			<div>
				<h3 class="text-4xl font-bold text-primary-teal mb-2">15+</h3>
				<p class="text-gray-600 dark:text-gray-300 text-sm font-medium">Years Experience</p>
			</div>
			<div>
				<h3 class="text-4xl font-bold text-primary-teal mb-2">4.9/5</h3>
				<p class="text-gray-600 dark:text-gray-300 text-sm font-medium">Guest Rating</p>
			</div>
		</div>
	</section>

	<main class="max-w-7xl mx-auto py-16 px-8">
		<div class="packages-grid grid grid-cols-1 lg:grid-cols-2 gap-8">
			<% 
			// Define constants outside the loop
			const borderColors = ['border-t-accent-blue', 'border-t-primary-teal', 'border-t-secondary-teal', 'border-t-dark-teal'];
			const badgeColors = ['bg-accent-blue/90', 'bg-primary-teal/90', 'bg-secondary-teal/90', 'bg-dark-teal/90'];
			const btnGradients = ['from-accent-blue to-primary-teal', 'from-primary-teal to-secondary-teal', 'from-secondary-teal to-primary-teal', 'from-dark-teal to-primary-teal'];
			const badges = ['Best Value', 'Most Popular', 'Exclusive', 'Family Friendly'];
			%>
			
			<% if (packages && packages.length > 0) { %>
				<% packages.forEach(function(pkg, index) { 
					const colorIndex = index % 4;
					const activities = pkg.Activities || [];
					const features = pkg.features || [];
					
					// Logic to determine what to display
					let displayItems = [];
					if (activities.length > 0) {
						displayItems = activities.slice(0, 3);
					} else if (features.length > 0) {
						displayItems = features.slice(0, 3);
					}
					
					const totalItems = activities.length > 0 ? activities.length : features.length;
					const remainingCount = Math.max(0, totalItems - 3);
					
					// Prepare variables for template to avoid complex expressions
					const pkgImage = pkg.image || pkg.img || '/assets/images/carousel/default.png';
					const pkgTitle = pkg.packageName || pkg.title;
					const pkgBadge = pkg.badge || badges[colorIndex];
					const pkgPrice = pkg.price;
					const pkgLocation = pkg.location;
					const pkgDuration = (pkg.days || pkg.nights || pkg.duration) ? (pkg.days || pkg.nights || '') + 'N/' + (pkg.nights || pkg.days || '') + 'D' : '';
					const pkgStay = pkg.Stay;
					const pkgHotel = pkg.hotelName;
					const borderColorClass = borderColors[colorIndex];
					const badgeColorClass = badgeColors[colorIndex];
					const btnGradientClass = btnGradients[colorIndex];
				%>
					<div class="bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl border-t-4 <%= borderColorClass %>">
						<div class="relative h-64 overflow-hidden">
							<img src="<%= pkgImage %>" alt="<%= pkgTitle %>" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105">
							<div class="absolute top-4 right-4 px-4 py-2 rounded-full font-semibold text-sm text-white backdrop-blur-lg <%= badgeColorClass %>">
								<%= pkgBadge %>
							</div>
							<% if (pkgPrice) { %>
							<div class="absolute bottom-4 left-4 bg-white dark:bg-gray-800 px-4 py-2 rounded-2xl font-bold shadow-lg">
								<span class="text-lg text-gray-800 dark:text-white">$<%= pkgPrice %></span>
								<small class="text-xs text-gray-600 dark:text-gray-400 font-medium">/per person</small>
							</div>
							<% } %>
						</div>

						<div class="p-5">
							<h3 class="text-xl font-bold text-gray-800 dark:text-white mb-3"><%= pkgTitle %></h3>
							
							<div class="flex flex-wrap items-center gap-2 mb-4 text-xs text-gray-600 dark:text-gray-400">
								<% if (pkgLocation) { %>
								<span class="flex items-center gap-1">
									<i class="fas fa-map-marker-alt"></i>
									<%= pkgLocation %>
								</span>
								<% } %>
								<% if (pkgDuration) { %>
								<span class="flex items-center gap-1">
									<i class="fas fa-calendar-alt"></i>
									<%= pkgDuration %>
								</span>
								<% } %>
								<% if (pkgStay) { %>
								<span class="flex items-center gap-1">
									<i class="fas fa-hotel"></i>
									<%= pkgStay %>
								</span>
								<% } %>
								<% if (pkgHotel) { %>
								<span class="flex items-center gap-1">
									<i class="fas fa-building"></i>
									<%= pkgHotel %>
								</span>
								<% } %>
							</div>

							<% if (displayItems.length > 0) { %>
							<div class="mb-4">
								<div class="flex flex-wrap gap-1.5">
									<% displayItems.forEach(function(item) { %>
										<span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs rounded-md">
											<%= item %>
										</span>
									<% }); %>
									
									<% if (remainingCount > 0) { %>
										<span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 text-xs rounded-md">
											+<%= remainingCount %> more
										</span>
									<% } %>
								</div>
							</div>
							<% } %>

							<button class="w-full py-3 border-0 rounded-xl font-semibold text-sm cursor-pointer transition-all duration-300 flex items-center justify-center gap-2 text-white bg-gradient-to-br <%= btnGradientClass %> hover:-translate-y-0.5 hover:shadow-xl" onclick="window.location.href='/api/login'">
								<span>Book This Package</span>
								<i class="fas fa-arrow-right"></i>
							</button>
						</div>
					</div>
				<% }); %>
			<% } else { %>
				<div class="col-span-full text-center py-12">
					<p class="text-gray-500 text-lg">No packages available at the moment.</p>
				</div>
			<% } %>
		</div>
	</main>

	<%- include('partials/footer') %>

	<script src="/assets/js/packages.js"></script>
</body>
</html>