<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Curated Packages - Palm Ways</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<script src="https://cdn.tailwindcss.com"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
	<script>
		tailwind.config = {
			theme: {
				extend: {
					fontFamily: {
						'poppins': ['Poppins', 'sans-serif']
					},
                    colors: {
                        'primary-teal': '#008080',
                        'secondary-teal': '#00cec9',
                        'dark-teal': '#1a535c',
                        'light-mint': '#e6f7f7',
                        'accent-blue': '#00bfff', // Using a cyan/blue accent for variety
                    }
				}
			}
		}
	</script>
	<link rel="stylesheet" href="/assets/css/packages.css">
</head>
<body class="font-poppins bg-gray-50 overflow-x-hidden transparent-navbar">
	<%- include('partials/navbar') %>

	<section class="py-32 px-8 text-white text-center relative overflow-hidden">
		<div class="absolute inset-0 z-0" style="background: url('/assets/images/headerbg.jpg') no-repeat center; background-size: cover;"></div>
		<div class="relative z-10 max-w-4xl mx-auto">
			<div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-lg px-5 py-2 rounded-full text-sm mb-6">
				<i class="fas fa-sparkles"></i>
				<span>🎉 Exclusive Offers · Save up to 30%</span>
			</div>
			<h1 class="text-5xl md:text-6xl font-bold mb-4">Curated Packages</h1>
			<p class="text-lg md:text-xl opacity-95 leading-relaxed">Discover our handcrafted vacation packages designed to create unforgettable experiences</p>
		</div>
	</section>

	<section class="bg-white py-12 px-8 
		shadow-sm">
		<div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 text-center">
			<div>
				<h3 class="text-4xl font-bold text-primary-teal mb-2">10,000+</h3>
				<p class="text-gray-600 text-sm font-medium">Happy Guests</p>
			</div>
			<div>
				<h3 class="text-4xl font-bold text-primary-teal mb-2">50+</h3>
				<p class="text-gray-600 text-sm font-medium">Destinations</p>
			</div>
			<div>
				<h3 class="text-4xl font-bold text-primary-teal mb-2">15+</h3>
				<p class="text-gray-600 text-sm font-medium">Years Experience</p>
			</div>
			<div>
				<h3 class="text-4xl font-bold text-primary-teal mb-2">4.9/5</h3>
				<p class="text-gray-600 text-sm font-medium">Guest Rating</p>
			</div>
		</div>
	</section>

	<main class="max-w-7xl mx-auto py-16 px-8">
		<div class="packages-grid grid grid-cols-1 lg:grid-cols-2 gap-8">
			<% 
			// Mapping the original colors to a Teal-centric palette
			const borderColors = ['border-t-accent-blue', 'border-t-primary-teal', 'border-t-secondary-teal', 'border-t-dark-teal'];
			const badgeColors = ['bg-accent-blue/90', 'bg-primary-teal/90', 'bg-secondary-teal/90', 'bg-dark-teal/90'];
			const iconBgColors = ['bg-blue-50', 'bg-light-mint', 'bg-secondary-teal/10', 'bg-dark-teal/10'];
			const iconTextColors = ['text-accent-blue', 'text-primary-teal', 'text-secondary-teal', 'text-dark-teal'];
			const btnGradients = ['from-accent-blue to-primary-teal', 'from-primary-teal to-secondary-teal', 'from-secondary-teal to-primary-teal', 'from-dark-teal to-primary-teal'];
			const icons = ['fa-umbrella-beach', 'fa-mountain-sun', 'fa-palm-tree', 'fa-water'];
			const badges = ['Best Value', 'Most Popular', 'Exclusive', 'Family Friendly'];
			packages.forEach((pkg, index) => { 
				const colorIndex = index % 4;
			%>
				<div class="bg-white rounded-2xl overflow-hidden shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl border-t-4 <%= borderColors[colorIndex] %>">
					<div class="relative h-64 overflow-hidden">
						<img src="<%= pkg.image || pkg.img || '/assets/images/headerbg.jpg' %>" alt="<%= pkg.packageName || pkg.title %>" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105">
						<div class="absolute top-4 right-4 px-4 py-2 rounded-full font-semibold text-sm text-white backdrop-blur-lg <%= badgeColors[colorIndex] %>">
							<%= pkg.badge || badges[colorIndex] %>
						</div>
						<% if (pkg.price) { %>
						<div class="absolute bottom-4 left-4 bg-white px-4 py-2 rounded-2xl font-bold shadow-lg">
							<span class="text-lg text-gray-800">$<%= pkg.price %></span>
							<small class="text-xs text-gray-600 font-medium">/per person</small>
						</div>
						<% } %>
					</div>

					<div class="p-5">
						<h3 class="text-xl font-bold text-gray-800 mb-3"><%= pkg.packageName || pkg.title %></h3>
						
						<!-- Compressed Info Row -->
						<div class="flex flex-wrap items-center gap-2 mb-4 text-xs text-gray-600">
							<% if (pkg.location) { %>
							<span class="flex items-center gap-1">
								<i class="fas fa-map-marker-alt"></i>
								<%= pkg.location %>
							</span>
							<% } %>
							<% if (pkg.days || pkg.nights || pkg.duration) { %>
							<span class="flex items-center gap-1">
								<i class="fas fa-calendar-alt"></i>
								<%= pkg.days || pkg.nights || '' %>N/<%= pkg.nights || pkg.days || '' %>D
							</span>
							<% } %>
							<% if (pkg.Stay) { %>
							<span class="flex items-center gap-1">
								<i class="fas fa-hotel"></i>
								<%= pkg.Stay %>
							</span>
							<% } %>
							<% if (pkg.hotelName) { %>
							<span class="flex items-center gap-1">
								<i class="fas fa-building"></i>
								<%= pkg.hotelName %>
							</span>
							<% } %>
						</div>

						<!-- Compressed Activities/Features - Show only first 3 -->
						<% if ((pkg.Activities && pkg.Activities.length > 0) || (pkg.features && pkg.features.length > 0)) { %>
						<div class="mb-4">
							<div class="flex flex-wrap gap-1.5">
								<% if (pkg.Activities && pkg.Activities.length > 0) { %>
									<% pkg.Activities.slice(0, 3).forEach(activity => { %>
									<span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded-md">
										<%= activity %>
									</span>
									<% }); %>
									<% if (pkg.Activities.length > 3) { %>
									<span class="px-2 py-1 bg-gray-100 text-gray-500 text-xs rounded-md">
										+<%= pkg.Activities.length - 3 %> more
									</span>
									<% } %>
								<% } %>
								<% if (pkg.features && pkg.features.length > 0 && (!pkg.Activities || pkg.Activities.length <= 3)) { %>
									<% pkg.features.slice(0, 3 - (pkg.Activities ? Math.min(pkg.Activities.length, 3) : 0)).forEach(feature => { %>
									<span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded-md">
										<%= feature %>
									</span>
									<% }); %>
								<% } %>
							</div>
						</div>
						<% } %>

						<button class="w-full py-3 border-0 rounded-xl font-semibold text-sm cursor-pointer transition-all duration-300 flex items-center justify-center gap-2 text-white bg-gradient-to-br <%= btnGradients[colorIndex] %> hover:-translate-y-0.5 hover:shadow-xl" onclick="handleBookPackage('<%= pkg._id %>', '<%= (pkg.packageName || pkg.title).replace(/'/g, "\\'") %>')">
							<span>Book This Package</span>
							<i class="fas fa-arrow-right"></i>
						</button>
					</div>
				</div>
			<% });
			%>
		</div>
	</main>

	<%- include('partials/footer') %>

	<script src="/assets/js/packages.js"></script>
</body>
</html>