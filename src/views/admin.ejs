<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Bookings - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/assets/css/theme.css" />
    <link rel="stylesheet" href="/assets/css/admin.css" />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              poppins: ["Poppins", "sans-serif"],
            },
            // Define a custom teal palette for easier access
            colors: {
              "primary-teal": "#008080",
              "secondary-teal": "#00cec9",
              "dark-teal": "#1a535c",
              "light-mint": "#e6f7f7",
            },
          },
        },
      };
    </script>
  </head>

  <body class="font-poppins min-h-screen pt-[76px]">
    <%- include('partials/navbar') %> <%- include('partials/alert') %>

    <div class="max-w-7xl mx-auto p-8">
      <div
        class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
      >
        <div class="flex-1">
          <h1 class="text-4xl font-bold text-gray-800 mb-2">
            Pending Booking Requests
          </h1>
          <p class="text-gray-500">
            Review and manage incoming booking requests
          </p>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="/api/create-package"
            class="teal-gradient text-white px-5 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-2 hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-suitcase"></i>
            <span>Create Package</span>
          </a>
          <a
            href="/api/create-stay-only"
            class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-2 hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-bed"></i>
            <span>Add Stay-Only</span>
          </a>
          <% const pendingCount = bookings.filter(b => b.status ===
          'pending').length; %>
          <div
            class="teal-gradient text-white px-5 py-2 rounded-full text-sm font-semibold inline-flex items-center gap-2"
          >
            <i class="fas fa-clock"></i>
            <span><%= pendingCount %> Pending</span>
          </div>
        </div>
      </div>

      <% if (bookings && bookings.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% bookings.forEach((booking) => { %>
            <% 
              const statusClass = booking.status ? booking.status.toLowerCase() : 'pending';
              // Calculate dates
              const arrivalDate = new Date(booking.arrivalDate || booking.arrival);
              const departureDate = new Date(booking.departureDate || booking.departure);
              const nights = Math.ceil((departureDate - arrivalDate) / (1000 * 60 * 60 * 24));
              // Format dates
              const checkInDate = arrivalDate.toLocaleDateString('en-US', {
                day: 'numeric',
                month: 'numeric',
                year: 'numeric'
              });
              const checkOutDate = departureDate.toLocaleDateString('en-US', {
                day: 'numeric',
                month: 'numeric',
                year: 'numeric'
              });
              // Format submitted time
              const submittedDate = booking.createdAt ? new Date(booking.createdAt) : new Date();
              const submittedTime = submittedDate.toLocaleString('en-US', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                hour12: true
              });
              // Use actual total from database
              const totalAmount = booking.totalAmount || booking.price || 0;
              const bookingTitle = booking.hotelName || booking.packageName || booking.title || booking.roomType || 'Booking Request';
            %>
            <div
              class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-all <%= statusClass === 'pending' ? 'border-2 border-primary-teal' : '' %>"
              data-booking-id="<%= booking._id %>"
            >
              <div class="relative h-48 bg-gradient-to-br from-primary-teal to-secondary-teal overflow-hidden">
                <% if (booking.image) { %>
                  <img
                    src="<%= booking.image %>"
                    alt="<%= bookingTitle %>"
                    class="w-full h-full object-cover"
                    onerror="this.onerror=null; this.style.display='none';"
                  />
                <% } %>
                <div class="absolute inset-0 flex items-center justify-center <%= booking.image ? 'pointer-events-none' : '' %>">
                  <i class="fas fa-calendar-check text-white text-6xl opacity-30"></i>
                </div>
                <div class="absolute top-2 right-2 bg-primary-teal text-white px-3 py-1 rounded-lg font-bold text-sm z-10">
                  REQ<%= String(booking.idx || booking._id.toString().slice(-3)).padStart(3, '0') %>
                </div>
                <% if (statusClass === 'pending') { %>
                <div class="absolute top-2 left-2 bg-yellow-500 text-white px-3 py-1 rounded-lg text-xs font-semibold z-10">
                  Pending
                </div>
                <% } else if (statusClass === 'approved') { %>
                <div class="absolute top-2 left-2 bg-green-500 text-white px-3 py-1 rounded-lg text-xs font-semibold z-10">
                  Approved
                </div>
                <% } else if (statusClass === 'rejected') { %>
                <div class="absolute top-2 left-2 bg-red-500 text-white px-3 py-1 rounded-lg text-xs font-semibold z-10">
                  Rejected
                </div>
                <% } %>
              </div>
              <div class="p-4">
                <h3 class="text-lg font-bold text-gray-800 mb-1"><%= booking.name || 'Guest' %></h3>
                <p class="text-sm text-primary-teal mb-2 font-semibold"><%= bookingTitle %></p>
                
                <div class="space-y-1 mb-3 text-xs text-gray-600">
                  <div class="flex items-center gap-1">
                    <i class="fas fa-calendar-alt w-3"></i>
                    <span><%= checkInDate %> - <%= checkOutDate %></span>
                  </div>
                  <div class="flex items-center gap-1">
                    <i class="fas fa-moon w-3"></i>
                    <span><%= nights %> nights</span>
                  </div>
                  <div class="flex items-center gap-1">
                    <i class="fas fa-users w-3"></i>
                    <span><%= booking.adults || 0 %> guests<% if (booking.children && booking.children > 0) { %> + <%= booking.children %> children<% } %></span>
                  </div>
                  <div class="flex items-center gap-1">
                    <i class="fas fa-dollar-sign w-3"></i>
                    <span class="font-bold text-primary-teal">$<%= typeof totalAmount === 'number' ? totalAmount.toFixed(2) : totalAmount %></span>
                  </div>
                </div>

                <div class="text-xs text-gray-500 mb-3 flex items-center gap-1">
                  <i class="fas fa-clock w-3"></i>
                  <span>Submitted <%= submittedTime.split(',')[0] %></span>
                </div>

                <% if (booking.specialRequests || booking.notes) { %>
                <div class="bg-light-mint border border-primary-teal/50 rounded-lg p-2 mb-3">
                  <p class="text-xs text-gray-700 line-clamp-2">
                    <i class="fas fa-sticky-note text-primary-teal mr-1"></i>
                    <%= (booking.specialRequests || booking.notes).substring(0, 50) %><% if ((booking.specialRequests || booking.notes).length > 50) { %>...<% } %>
                  </p>
                </div>
                <% } %>

                <div class="flex gap-2 mt-4">
                  <% if (statusClass === 'pending') { %>
                  <button
                    onclick="updateBookingStatus('<%= booking._id %>', 'approved')"
                    class="flex-1 bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-3 rounded-lg transition-all text-xs flex items-center justify-center gap-1"
                    title="Accept Booking"
                  >
                    <i class="fas fa-check"></i>
                    Accept
                  </button>
                  <button
                    onclick="updateBookingStatus('<%= booking._id %>', 'rejected')"
                    class="flex-1 bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-3 rounded-lg transition-all text-xs flex items-center justify-center gap-1"
                    title="Reject Booking"
                  >
                    <i class="fas fa-times"></i>
                    Reject
                  </button>
                  <% } %>
                  <button
                    onclick="editBooking('<%= booking._id %>')"
                    class="flex-1 bg-primary-teal hover:bg-dark-teal text-white font-semibold py-2 px-3 rounded-lg transition-all text-xs flex items-center justify-center gap-1"
                    title="Edit Booking"
                  >
                    <i class="fas fa-edit"></i>
                    Edit
                  </button>
                  <button
                    onclick="deleteBooking('<%= booking._id %>')"
                    class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-3 rounded-lg transition-all text-xs flex items-center justify-center gap-1"
                    title="Delete Booking"
                  >
                    <i class="fas fa-trash"></i>
                    Delete
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
      <div class="bg-white rounded-xl shadow-md p-16 text-center">
        <i class="fas fa-calendar-check text-6xl text-gray-300 mb-4"></i>
        <h3 class="text-2xl font-bold text-gray-700 mb-2">
          No Pending Requests
        </h3>
        <p class="text-gray-500">All booking requests have been processed</p>
      </div>
      <% } %>

      <!-- Packages Management Section -->
      <div class="mt-12 mb-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-3xl font-bold text-gray-800 mb-2">Packages Management</h2>
            <p class="text-gray-500">Manage vacation packages</p>
          </div>
          <a
            href="/api/create-package"
            class="teal-gradient text-white px-5 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-2 hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-plus"></i>
            <span>Add Package</span>
          </a>
        </div>

        <% if (packages && packages.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% packages.forEach((pkg) => { %>
          <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-all">
            <div class="relative h-48">
              <img
                src="<%= pkg.image || pkg.img || '/assets/images/headerbg.jpg' %>"
                alt="<%= pkg.packageName %>"
                class="w-full h-full object-cover"
              />
              <% if (pkg.price) { %>
              <div class="absolute top-2 right-2 bg-primary-teal text-white px-3 py-1 rounded-lg font-bold text-sm">
                $<%= pkg.price %>
              </div>
              <% } %>
            </div>
            <div class="p-4">
              <h3 class="text-lg font-bold text-gray-800 mb-2"><%= pkg.packageName %></h3>
              <p class="text-sm text-gray-600 mb-3 line-clamp-2"><%= pkg.description || '' %></p>
              <div class="flex gap-2 mt-4">
                <button
                  onclick="editPackage('<%= pkg._id %>')"
                  class="flex-1 bg-primary-teal hover:bg-dark-teal text-white font-semibold py-2 px-4 rounded-lg transition-all text-sm flex items-center justify-center gap-2"
                >
                  <i class="fas fa-edit"></i>
                  Edit
                </button>
                <button
                  onclick="deletePackage('<%= pkg._id %>', '<%= pkg.packageName %>')"
                  class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition-all text-sm flex items-center justify-center gap-2"
                >
                  <i class="fas fa-trash"></i>
                  Delete
                </button>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="bg-white rounded-xl shadow-md p-12 text-center">
          <i class="fas fa-suitcase text-6xl text-gray-300 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-700 mb-2">No Packages</h3>
          <p class="text-gray-500 mb-4">Create your first package to get started</p>
          <a
            href="/api/create-package"
            class="inline-block teal-gradient text-white px-6 py-2 rounded-lg font-semibold hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-plus mr-2"></i>Create Package
          </a>
        </div>
        <% } %>
      </div>

      <!-- Stay-Only Management Section -->
      <div class="mt-12 mb-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-3xl font-bold text-gray-800 mb-2">Stay-Only Accommodations</h2>
            <p class="text-gray-500">Manage hotel and accommodation listings</p>
          </div>
          <a
            href="/api/create-stay-only"
            class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-2 hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-plus"></i>
            <span>Add Stay-Only</span>
          </a>
        </div>

        <% if (stayOnlyList && stayOnlyList.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% stayOnlyList.forEach((stay) => { %>
          <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-all">
            <div class="relative h-48">
              <img
                src="<%= stay.image || stay.img || '/assets/images/headerbg.jpg' %>"
                alt="<%= stay.name %>"
                class="w-full h-full object-cover"
              />
              <% if (stay.price) { %>
              <div class="absolute top-2 right-2 bg-primary-teal text-white px-3 py-1 rounded-lg font-bold text-sm">
                $<%= stay.price %>/night
              </div>
              <% } %>
              <% if (stay.type) { %>
              <div class="absolute top-2 left-2 bg-white/90 px-3 py-1 rounded-lg text-xs font-semibold text-gray-700 capitalize">
                <%= stay.type %>
              </div>
              <% } %>
            </div>
            <div class="p-4">
              <h3 class="text-lg font-bold text-gray-800 mb-2"><%= stay.name %></h3>
              <p class="text-sm text-gray-600 mb-1">
                <% if (stay.location) { %>
                <i class="fas fa-map-marker-alt text-primary-teal mr-1"></i><%= stay.location %>
                <% } %>
              </p>
              <p class="text-sm text-gray-600 mb-3 line-clamp-2"><%= stay.description || '' %></p>
              <div class="flex gap-2 mt-4">
                <button
                  onclick="editStayOnly('<%= stay._id %>')"
                  class="flex-1 bg-primary-teal hover:bg-dark-teal text-white font-semibold py-2 px-4 rounded-lg transition-all text-sm flex items-center justify-center gap-2"
                >
                  <i class="fas fa-edit"></i>
                  Edit
                </button>
                <button
                  onclick="deleteStayOnly('<%= stay._id %>', '<%= stay.name %>')"
                  class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition-all text-sm flex items-center justify-center gap-2"
                >
                  <i class="fas fa-trash"></i>
                  Delete
                </button>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="bg-white rounded-xl shadow-md p-12 text-center">
          <i class="fas fa-bed text-6xl text-gray-300 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-700 mb-2">No Stay-Only Accommodations</h3>
          <p class="text-gray-500 mb-4">Create your first accommodation to get started</p>
          <a
            href="/api/create-stay-only"
            class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-semibold hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-plus mr-2"></i>Create Stay-Only
          </a>
        </div>
        <% } %>
      </div>
    </div>

    <%- include('partials/footer') %>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/assets/js/admin.js"></script>
  </body>
</html>
