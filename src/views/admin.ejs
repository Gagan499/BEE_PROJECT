<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Bookings - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/assets/css/theme.css" />
    <link rel="stylesheet" href="/assets/css/admin.css" />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              poppins: ["Poppins", "sans-serif"],
            },
            // Define a custom teal palette for easier access
            colors: {
              "primary-teal": "#008080",
              "secondary-teal": "#00cec9",
              "dark-teal": "#1a535c",
              "light-mint": "#e6f7f7",
            },
          },
        },
      };
    </script>
  </head>

  <body class="font-poppins min-h-screen pt-[76px]">
    <%- include('partials/navbar') %> <%- include('partials/alert') %>

    <div class="max-w-7xl mx-auto p-8">
      <div
        class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
      >
        <div class="flex-1">
          <h1 class="text-4xl font-bold text-gray-800 mb-2">
            Pending Booking Requests
          </h1>
          <p class="text-gray-500">
            Review and manage incoming booking requests
          </p>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="/api/create-package"
            class="teal-gradient text-white px-5 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-2 hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-suitcase"></i>
            <span>Create Package</span>
          </a>
          <a
            href="/api/create-stay-only"
            class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-2 hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-bed"></i>
            <span>Add Stay-Only</span>
          </a>
          <% const pendingCount = bookings.filter(b => b.status ===
          'pending').length; %>
          <div
            class="teal-gradient text-white px-5 py-2 rounded-full text-sm font-semibold inline-flex items-center gap-2"
          >
            <i class="fas fa-clock"></i>
            <span><%= pendingCount %> Pending</span>
          </div>
        </div>
      </div>

      <% if (bookings && bookings.length > 0) { %>
        <% bookings.forEach((booking) => { %>
          <% 
            const statusClass = booking.status ? booking.status.toLowerCase() : 'pending';
            // Calculate dates
            const arrivalDate = new Date(booking.arrivalDate || booking.arrival);
            const departureDate = new Date(booking.departureDate || booking.departure);
            const nights = Math.ceil((departureDate - arrivalDate) / (1000 * 60 * 60 * 24));
            // Format dates
            const checkInDate = arrivalDate.toLocaleDateString('en-US', {
              day: 'numeric',
              month: 'numeric',
              year: 'numeric'
            });
            const checkOutDate = departureDate.toLocaleDateString('en-US', {
              day: 'numeric',
              month: 'numeric',
              year: 'numeric'
            });
            // Format submitted time
            const submittedDate = booking.createdAt ? new Date(booking.createdAt) : new Date();
            const submittedTime = submittedDate.toLocaleString('en-US', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
              hour: '2-digit',
              minute: '2-digit',
              hour12: true
            });
            // Use actual total from database
            const totalAmount = booking.totalAmount || booking.price || 0;
          %>
      <div
        class="bg-white rounded-xl shadow-md p-6 mb-6 transition-all duration-300 hover:shadow-lg <%= statusClass === 'pending' ? 'border-l-4 border-primary-teal' : '' %>"
        data-booking-id="<%= booking._id %>"
      >
        <div
          class="flex flex-col sm:flex-row justify-between items-start gap-4 pb-4 border-b border-gray-200"
        >
          <div class="flex-1 w-full">
            <div class="flex items-center gap-3 mb-3">
              <i class="fas fa-user-circle text-3xl text-primary-teal"></i>
              <span class="text-xl font-bold text-gray-800"
                ><%= booking.name || '' %></span
              >
            </div>
            <div class="flex flex-col gap-2 text-sm text-gray-600">
              <% if (booking.email) { %>
              <div class="flex items-center gap-2">
                <i class="fas fa-envelope w-4"></i>
                <span><%= booking.email %></span>
              </div>
              <% } %> <% if (booking.phone || booking.phoneNumber) { %>
              <div class="flex items-center gap-2">
                <i class="fas fa-phone w-4"></i>
                <span><%= booking.phone || booking.phoneNumber %></span>
              </div>
              <% } %>
            </div>
            <div class="flex items-center gap-2 mt-3 text-xs text-gray-500">
              <i class="fas fa-clock"></i>
              <span>Submitted <%= submittedTime %></span>
            </div>
          </div>
          <div
            class="teal-gradient text-white px-4 py-2 rounded-lg text-sm font-bold"
          >
            REQ<%= String(booking.idx ||
            booking._id.toString().slice(-3)).padStart(3, '0') %>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 py-4">
          <div class="flex flex-col">
            <span class="text-xs text-gray-500 mb-1">Room Type</span>
            <span class="text-base font-semibold text-gray-800"
              ><%= booking.hotelName || booking.packageName || booking.title ||
              booking.roomType || '' %></span
            >
          </div>
          <div class="flex flex-col">
            <span class="text-xs text-gray-500 mb-1">Total Amount</span>
            <span class="text-base font-bold text-primary-teal"
              >$<%= typeof totalAmount === 'number' ? totalAmount.toFixed(2) :
              totalAmount %></span
            >
          </div>
          <div class="flex flex-col">
            <span class="text-xs text-gray-500 mb-1">Check-in</span>
            <span class="text-base font-semibold text-gray-800"
              ><%= checkInDate %></span
            >
          </div>
          <div class="flex flex-col">
            <span class="text-xs text-gray-500 mb-1">Check-out</span>
            <span class="text-base font-semibold text-gray-800"
              ><%= checkOutDate %></span
            >
          </div>
        </div>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 gap-4 py-4 border-t border-gray-200"
        >
          <div class="flex flex-col">
            <span class="text-xs text-gray-500 mb-1">Nights</span>
            <span class="text-base font-semibold text-gray-800"
              ><%= nights %> nights</span
            >
          </div>
          <div class="flex flex-col">
            <span class="text-xs text-gray-500 mb-1">Guests</span>
            <span class="text-base font-semibold text-gray-800"
              ><%= booking.adults || 0 %><% if (booking.children &&
              booking.children > 0) { %> + <%= booking.children %> children<% }
              %></span
            >
          </div>
        </div>

        <% if (booking.specialRequests || booking.notes) { %>
        <div
          class="bg-light-mint border border-primary-teal/50 rounded-lg p-4 my-4"
        >
          <div
            class="text-sm font-semibold text-dark-teal mb-2 flex items-center gap-2"
          >
            <i class="fas fa-sticky-note"></i>
            Special Requests
          </div>
          <div class="text-sm text-gray-700 leading-relaxed">
            <%= booking.specialRequests || booking.notes %>
          </div>
        </div>
        <% } %>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
          <% if (statusClass === 'pending') { %>
          <button
            class="bg-green-500 hover:bg-green-600 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed btn"
            onclick="updateBookingStatus('<%= booking._id %>', 'approved')"
          >
            <i class="fas fa-check"></i>
            Accept Booking
          </button>
          <button
            class="bg-red-500 hover:bg-red-600 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed btn"
            onclick="updateBookingStatus('<%= booking._id %>', 'rejected')"
          >
            <i class="fas fa-times"></i>
            Reject Booking
          </button>
          <% } %>
          <button
            class="bg-primary-teal hover:bg-dark-teal text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed btn"
            onclick="editBooking('<%= booking._id %>')"
          >
            <i class="fas fa-edit"></i>
            Edit Booking
          </button>
          <button
            class="bg-red-600 hover:bg-red-700 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 flex items-center justify-center gap-2 shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed btn"
            onclick="deleteBooking('<%= booking._id %>')"
          >
            <i class="fas fa-trash"></i>
            Delete Booking
          </button>
        </div>
      </div>
        <% }); %>
      <% } else { %>
      <div class="bg-white rounded-xl shadow-md p-16 text-center">
        <i class="fas fa-calendar-check text-6xl text-gray-300 mb-4"></i>
        <h3 class="text-2xl font-bold text-gray-700 mb-2">
          No Pending Requests
        </h3>
        <p class="text-gray-500">All booking requests have been processed</p>
      </div>
      <% } %>

      <!-- Packages Management Section -->
      <div class="mt-12 mb-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-3xl font-bold text-gray-800 mb-2">Packages Management</h2>
            <p class="text-gray-500">Manage vacation packages</p>
          </div>
          <a
            href="/api/create-package"
            class="teal-gradient text-white px-5 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-2 hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-plus"></i>
            <span>Add Package</span>
          </a>
        </div>

        <% if (packages && packages.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% packages.forEach((pkg) => { %>
          <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-all">
            <div class="relative h-48">
              <img
                src="<%= pkg.image || pkg.img || '/assets/images/carousel/default.png' %>"
                alt="<%= pkg.packageName %>"
                class="w-full h-full object-cover"
              />
              <% if (pkg.price) { %>
              <div class="absolute top-2 right-2 bg-primary-teal text-white px-3 py-1 rounded-lg font-bold text-sm">
                $<%= pkg.price %>
              </div>
              <% } %>
            </div>
            <div class="p-4">
              <h3 class="text-lg font-bold text-gray-800 mb-2"><%= pkg.packageName %></h3>
              <p class="text-sm text-gray-600 mb-3 line-clamp-2"><%= pkg.description || '' %></p>
              <div class="flex gap-2 mt-4">
                <button
                  onclick="editPackage('<%= pkg._id %>')"
                  class="flex-1 bg-primary-teal hover:bg-dark-teal text-white font-semibold py-2 px-4 rounded-lg transition-all text-sm flex items-center justify-center gap-2"
                >
                  <i class="fas fa-edit"></i>
                  Edit
                </button>
                <button
                  onclick="deletePackage('<%= pkg._id %>', '<%= pkg.packageName %>')"
                  class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition-all text-sm flex items-center justify-center gap-2"
                >
                  <i class="fas fa-trash"></i>
                  Delete
                </button>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="bg-white rounded-xl shadow-md p-12 text-center">
          <i class="fas fa-suitcase text-6xl text-gray-300 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-700 mb-2">No Packages</h3>
          <p class="text-gray-500 mb-4">Create your first package to get started</p>
          <a
            href="/api/create-package"
            class="inline-block teal-gradient text-white px-6 py-2 rounded-lg font-semibold hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-plus mr-2"></i>Create Package
          </a>
        </div>
        <% } %>
      </div>

      <!-- Stay-Only Management Section -->
      <div class="mt-12 mb-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-3xl font-bold text-gray-800 mb-2">Stay-Only Accommodations</h2>
            <p class="text-gray-500">Manage hotel and accommodation listings</p>
          </div>
          <a
            href="/api/create-stay-only"
            class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg text-sm font-semibold inline-flex items-center gap-2 hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-plus"></i>
            <span>Add Stay-Only</span>
          </a>
        </div>

        <% if (stayOnlyList && stayOnlyList.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% stayOnlyList.forEach((stay) => { %>
          <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-all">
            <div class="relative h-48">
              <img
                src="<%= stay.image || stay.img || '/assets/images/carousel/default.png' %>"
                alt="<%= stay.name %>"
                class="w-full h-full object-cover"
              />
              <% if (stay.price) { %>
              <div class="absolute top-2 right-2 bg-primary-teal text-white px-3 py-1 rounded-lg font-bold text-sm">
                $<%= stay.price %>/night
              </div>
              <% } %>
              <% if (stay.type) { %>
              <div class="absolute top-2 left-2 bg-white/90 px-3 py-1 rounded-lg text-xs font-semibold text-gray-700 capitalize">
                <%= stay.type %>
              </div>
              <% } %>
            </div>
            <div class="p-4">
              <h3 class="text-lg font-bold text-gray-800 mb-2"><%= stay.name %></h3>
              <p class="text-sm text-gray-600 mb-1">
                <% if (stay.location) { %>
                <i class="fas fa-map-marker-alt text-primary-teal mr-1"></i><%= stay.location %>
                <% } %>
              </p>
              <p class="text-sm text-gray-600 mb-3 line-clamp-2"><%= stay.description || '' %></p>
              <div class="flex gap-2 mt-4">
                <button
                  onclick="editStayOnly('<%= stay._id %>')"
                  class="flex-1 bg-primary-teal hover:bg-dark-teal text-white font-semibold py-2 px-4 rounded-lg transition-all text-sm flex items-center justify-center gap-2"
                >
                  <i class="fas fa-edit"></i>
                  Edit
                </button>
                <button
                  onclick="deleteStayOnly('<%= stay._id %>', '<%= stay.name %>')"
                  class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition-all text-sm flex items-center justify-center gap-2"
                >
                  <i class="fas fa-trash"></i>
                  Delete
                </button>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="bg-white rounded-xl shadow-md p-12 text-center">
          <i class="fas fa-bed text-6xl text-gray-300 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-700 mb-2">No Stay-Only Accommodations</h3>
          <p class="text-gray-500 mb-4">Create your first accommodation to get started</p>
          <a
            href="/api/create-stay-only"
            class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-semibold hover:opacity-90 transition-opacity"
          >
            <i class="fas fa-plus mr-2"></i>Create Stay-Only
          </a>
        </div>
        <% } %>
      </div>
    </div>

    <%- include('partials/footer') %>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/assets/js/admin.js"></script>
  </body>
</html>
