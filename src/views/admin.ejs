            </div>
            <!-- Example Booking Card 2 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-green-600">
                <h2 class="text-2xl font-bold">Palm Resort</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> Priya Sharma</div>
                    <div><span class="font-semibold">From:</span> Mumbai</div>
                    <div><span class="font-semibold">Arrival:</span> 2025-06-10 at 15:00</div>
                    <div><span class="font-semibold">Return:</span> 2025-06-15 at 12:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-green-600 text-white font-semibold hover:bg-green-700 transition">View this booking</button>
            </div>
            <!-- Example Booking Card 3 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-green-600">
                <h2 class="text-2xl font-bold">City Inn</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> Rahul Verma</div>
                    <div><span class="font-semibold">From:</span> Delhi</div>
                    <div><span class="font-semibold">Arrival:</span> 2025-07-01 at 09:30</div>
                    <div><span class="font-semibold">Return:</span> 2025-07-03 at 18:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-green-600 text-white font-semibold hover:bg-green-700 transition">View this booking</button>
            </div>
        </div>
        <div id="past-section" class="grid grid-cols-1 md:grid-cols-2 gap-8 hidden">
            <!-- Example Past Booking Card 1 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-gray-500">
                <h2 class="text-2xl font-bold">Past Hotel</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> John Doe</div>
                    <div><span class="font-semibold">From:</span> Dubai</div>
                    <div><span class="font-semibold">Arrival:</span> 2024-12-01 at 10:00</div>
                    <div><span class="font-semibold">Return:</span> 2024-12-05 at 10:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-gray-500 text-white font-semibold hover:bg-gray-600 transition">View this booking</button>
            </div>
            <!-- Example Past Booking Card 2 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-gray-500">
                <h2 class="text-2xl font-bold">Sunrise Suites</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> Aisha Khan</div>
                    <div><span class="font-semibold">From:</span> Abu Dhabi</div>
                    <div><span class="font-semibold">Arrival:</span> 2024-11-20 at 14:00</div>
                    <div><span class="font-semibold">Return:</span> 2024-11-22 at 11:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-gray-500 text-white font-semibold hover:bg-gray-600 transition">View this booking</button>
            </div>
            <!-- Example Past Booking Card 3 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-gray-500">
                <h2 class="text-2xl font-bold">Royal Stay</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> Meera Patel</div>
                    <div><span class="font-semibold">From:</span> Jaipur</div>
                    <div><span class="font-semibold">Arrival:</span> 2024-10-10 at 12:00</div>
                    <div><span class="font-semibold">Return:</span> 2024-10-12 at 10:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-gray-500 text-white font-semibold hover:bg-gray-600 transition">View this booking</button>
            </div>
        </div>
    </main>

    <footer class="bg-[#2D2F3E] w-full py-10 px-4 mt-12">
        <style>
            .footer-link { color: #fff; text-decoration: none; transition: color 0.2s; }
            .footer-link:hover { color: #16a34a; }
            .footer-icon { color: #fff; transition: color 0.2s; }
            .footer-icon:hover { color: #16a34a; }
        </style>
        <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center md:items-stretch justify-center md:justify-between gap-0 md:gap-0">
            <div class="flex flex-col items-center md:items-start justify-center flex-1 min-w-[220px] py-4">
                <img src="../../public/assets/images/logo.png" alt="Logo" class="h-12 w-auto mb-2">
                <span class="text-white text-2xl font-bold mb-4">ThePalmWay</span>
                <ul class="text-lg list-none p-0 m-0 space-y-2">
                    <li><a href="#" class="footer-link">About Us</a></li>
                    <li><a href="#" class="footer-link">Careers</a></li>
                    <li><a href="#" class="footer-link">Join Us</a></li>
                    <li><a href="#" class="footer-link">Partners</a></li>
                </ul>
            </div>
            <div class="hidden md:flex flex-col items-center justify-center px-8">
                <div class="border-l border-gray-400 h-36"></div>
            </div>
            <div class="flex flex-col items-center md:items-start justify-center flex-1 min-w-[220px] py-4">
                <span class="text-white text-lg mb-6 text-center md:text-left">Abc Avenue,<br>123 Street,<br>New York, USA</span>
                <div class="w-full border-t border-gray-400 my-4 md:hidden"></div>
                <div class="flex flex-row gap-10 justify-center md:justify-start w-full mt-2">
                    <a href="#" class="footer-icon text-2xl" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
                    <a href="#" class="footer-icon text-2xl" aria-label="X"><i class="fa fa-times"></i></a>
                    <a href="#" class="footer-icon text-2xl" aria-label="Email"><i class="fa fa-envelope"></i></a>
                </div>
            </div>
        </div>
        <div class="mt-8 text-center text-gray-300 text-base">
            Copyrights reserved SastaZomato © 2025
        </div>
    </footer>

    <script>
        // Fixed header on scroll past header height
        const parallaxHeader = document.getElementById('parallax-header');
        const headerPlaceholder = document.getElementById('header-placeholder');
        let headerFixed = false;
        function handleHeaderFixed() {
            const scrollY = window.scrollY;
            const headerHeight = parallaxHeader.offsetHeight;
            if (scrollY > headerHeight) {
                if (!headerFixed) {
                    parallaxHeader.style.position = 'fixed';
                    parallaxHeader.style.top = '0';
                    parallaxHeader.style.left = '0';
                    parallaxHeader.style.right = '0';
                    parallaxHeader.style.zIndex = '50';
                    parallaxHeader.style.background = '#2D2F3E';
                    parallaxHeader.style.boxShadow = '0 2px 8px 0 rgba(0,0,0,0.08)';
                    headerPlaceholder.style.height = headerHeight + 'px';
                    // Hide parallax background and title
                    document.getElementById('parallax-bg').style.opacity = '0';
                    document.getElementById('header-title').style.opacity = '0';
                }
                headerFixed = true;
            } else {
                if (headerFixed) {
                    parallaxHeader.style.position = 'relative';
                    parallaxHeader.style.background = 'transparent';
                    parallaxHeader.style.boxShadow = 'none';
                    headerPlaceholder.style.height = '0';
                    document.getElementById('parallax-bg').style.opacity = '1';
                    document.getElementById('header-title').style.opacity = '1';
                }
                headerFixed = false;
            }
        }
        window.addEventListener('scroll', handleHeaderFixed);
        window.addEventListener('resize', handleHeaderFixed);
        window.addEventListener('DOMContentLoaded', handleHeaderFixed);
        // Parallax effect for header background
        const parallaxBg = document.getElementById('parallax-bg');
        window.addEventListener('scroll', function() {
            const scrolled = window.scrollY;
            // Move background slower than scroll for parallax
            parallaxBg.style.transform = `translateY(${scrolled * 0.4}px)`;
        });
        // Scroll-aware navbar background
        const navbar = document.getElementById('main-navbar');
        const header = navbar.parentElement;
        function updateNavbarBg() {
            const headerRect = header.getBoundingClientRect();
            if (headerRect.bottom <= 0) {
                navbar.style.background = '#2d2f3e';
                navbar.style.boxShadow = '0 2px 8px 0 rgba(0,0,0,0.08)';
            } else {
                navbar.style.background = 'transparent';
                navbar.style.boxShadow = 'none';
            }
        }
        window.addEventListener('scroll', updateNavbarBg);
        window.addEventListener('DOMContentLoaded', updateNavbarBg);


        // Toggle booking sections
        const showUpcomingBtn = document.getElementById('show-upcoming');
        const showPastBtn = document.getElementById('show-past');
        const upcomingSection = document.getElementById('upcoming-section');
        const pastSection = document.getElementById('past-section');

        showUpcomingBtn.addEventListener('click', () => {
            upcomingSection.classList.remove('hidden');
            pastSection.classList.add('hidden');
            showUpcomingBtn.classList.add('bg-blue-600', 'text-white');
            showUpcomingBtn.classList.remove('bg-gray-300', 'text-gray-800');
            showPastBtn.classList.remove('bg-blue-600', 'text-white');
            showPastBtn.classList.add('bg-gray-300', 'text-gray-800');
        });
        showPastBtn.addEventListener('click', () => {
            pastSection.classList.remove('hidden');
            upcomingSection.classList.add('hidden');
            showPastBtn.classList.add('bg-blue-600', 'text-white');
            showPastBtn.classList.remove('bg-gray-300', 'text-gray-800');
            showUpcomingBtn.classList.remove('bg-blue-600', 'text-white');
            showUpcomingBtn.classList.add('bg-gray-300', 'text-gray-800');
        });

        // Navbar hamburger/cross toggle
        const navbarToggle = document.getElementById('navbar-toggle');
        const navbarMenu = document.getElementById('navbar-menu');
        let navbarOpen = false;
        navbarToggle.addEventListener('click', () => {
            navbarOpen = !navbarOpen;
            if (navbarOpen) {
                navbarMenu.classList.remove('hidden');
                navbarToggle.classList.add('open');
                // Animate hamburger to symmetric cross (shorter arms)
                document.getElementById('bar1').style.transform = 'rotate(45deg) translateY(7px) scaleX(0.7)';
                document.getElementById('bar2').style.opacity = '0';
                document.getElementById('bar3').style.transform = 'rotate(-45deg) translateY(-7px) scaleX(0.7)';
            } else {
                navbarMenu.classList.add('hidden');
                navbarToggle.classList.remove('open');
                // Animate cross to hamburger
                document.getElementById('bar1').style.transform = '';
                document.getElementById('bar2').style.opacity = '';
                document.getElementById('bar3').style.transform = '';
            }
        });

        // Filter dropdown
        const filterBtn = document.getElementById('filter-btn');
        const filterMenu = document.getElementById('filter-menu');
        filterBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            filterMenu.classList.toggle('hidden');
            sortMenu.classList.add('hidden');
        });
        // Sort dropdown
        const sortBtn = document.getElementById('sort-btn');
        const sortMenu = document.getElementById('sort-menu');
        sortBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            sortMenu.classList.toggle('hidden');
            filterMenu.classList.add('hidden');
        });
        // Hide dropdowns on click outside
        document.addEventListener('click', () => {
            filterMenu.classList.add('hidden');
            sortMenu.classList.add('hidden');
        });

        // Dummy filter/sort functions
        function filterBy(type) {
            // Implement actual filtering logic here
            // No popup, just placeholder for future logic
        }
        function sortBy(type) {
            // Implement actual sorting logic here
            // No popup, just placeholder for future logic
        }
    </script>
</body>
</html>