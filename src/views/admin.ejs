            <button id="show-past" class="flex-1 py-2 rounded-lg text-base font-bold bg-gray-300 text-gray-800 hover:bg-gray-400 transition">Past bookings</button>
        </div>

        <div id="upcoming-section" class="grid grid-cols-1 md:grid-cols-2 gap-8">
