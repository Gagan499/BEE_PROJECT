<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - My Bookings</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <header id="parallax-header" class="relative w-full h-56 md:h-72 lg:h-80 flex items-center overflow-hidden transition-all duration-300">
    <div class="absolute inset-0 w-full h-full bg-cover bg-center will-change-transform" id="parallax-bg" style="background-image: url('../../public/assets/images/headerbg.jpg'); z-index:1;"></div>
    <div class="relative z-20 flex w-full items-center justify-between px-6 pt-6" id="header-content">
            <img src="assets/images/logo.png" alt="Logo" class="h-12 md:h-16 lg:h-20 w-auto">
            <button id="navbar-toggle" class="group flex flex-col items-center justify-center w-12 h-12 rounded-lg bg-white bg-opacity-10 hover:bg-opacity-20 transition relative">
                <span class="bar block w-8 h-1 bg-white mb-2 rounded transition-all duration-300" id="bar1"></span>
                <span class="bar block w-8 h-1 bg-white mb-2 rounded transition-all duration-300" id="bar2"></span>
                <span class="bar block w-8 h-1 bg-white rounded transition-all duration-300" id="bar3"></span>
            </button>
        </div>
        <div class="absolute inset-0 flex items-center justify-center z-10" id="header-title">
            <h1 class="text-white text-5xl md:text-7xl lg:text-8xl font-bold drop-shadow-lg text-center" style="font-family: 'Alatsi', Arial, sans-serif;">My Bookings</h1>
        </div>
        <nav id="main-navbar" class="absolute top-0 left-0 w-full z-30 transition-colors duration-300">
            <div id="navbar-menu" class="hidden absolute top-20 right-6 mt-2 w-40 bg-[#2d2f3e] rounded-lg shadow-lg py-2 flex flex-col items-center animate-fade-in z-30">
                <a href="#" class="text-white px-3 py-1 hover:bg-gray-700 w-full text-center text-sm">Dashboard</a>
                <a href="#" class="text-white px-3 py-1 hover:bg-gray-700 w-full text-center text-sm">Bookings</a>
                <a href="#" class="text-white px-3 py-1 hover:bg-gray-700 w-full text-center text-sm">Profile</a>
                <a href="#" class="text-white px-3 py-1 hover:bg-gray-700 w-full text-center text-sm">Logout</a>
            </div>
        </nav>
    </header>

    <!-- Header placeholder for fixed header offset -->
    <div id="header-placeholder" style="height: 0;"></div>
    <main class="flex-1 w-full max-w-5xl mx-auto px-2 py-4">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4 mt-2">
            <div class="flex items-center gap-2">
                <button class="px-4 py-1.5 rounded-full bg-green-600 text-white font-semibold shadow hover:bg-green-700 transition text-sm">New Booking</button>
                <!-- Filter Dropdown -->
                <div class="relative">
                    <button id="filter-btn" class="px-4 py-1.5 rounded-full bg-gray-200 text-gray-800 font-semibold shadow hover:bg-gray-300 transition flex items-center gap-1 text-sm">Filter <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></button>
                    <div id="filter-menu" class="hidden absolute left-0 mt-1 w-40 bg-white rounded-lg shadow-lg py-1 z-20">
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="filterBy('upcoming')">Upcoming</button>
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="filterBy('past')">Past</button>
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="filterBy('all')">All</button>
                    </div>
                </div>
                <!-- Sort Dropdown -->
                <div class="relative">
                    <button id="sort-btn" class="px-4 py-1.5 rounded-full bg-gray-200 text-gray-800 font-semibold shadow hover:bg-gray-300 transition flex items-center gap-1 text-sm">Sort <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg></button>
                    <div id="sort-menu" class="hidden absolute left-0 mt-1 w-40 bg-white rounded-lg shadow-lg py-1 z-20">
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="sortBy('arrival')">Arrival Date</button>
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="sortBy('return')">Return Date</button>
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="sortBy('name')">Name</button>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-1">
                <span class="px-3 py-1 rounded-full bg-green-600 text-white font-semibold text-sm">Dubai</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="px-4 py-1.5 rounded-full bg-green-600 text-white font-semibold text-sm">Upcoming Trips</span>
                <span class="px-4 py-1.5 rounded-full bg-green-600 text-white font-semibold text-sm">1234@gmail.com</span>
            </div>
        </div>

        <div class="flex flex-col md:flex-row gap-2 mb-3">
