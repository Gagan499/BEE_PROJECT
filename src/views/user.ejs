<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <link rel="shortcut icon" href="/assets/images/favicon_icon.png" type="image/x-icon">
    <title>Admin - My Bookings</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <header id="parallax-header" class="relative w-full h-40 md:h-56 lg:h-72 flex items-center justify-between overflow-hidden">
        <div class="absolute inset-0 w-full h-full bg-cover bg-center will-change-transform" id="parallax-bg" style="background-image: url('../../public/assets/images/headerbg.jpg'); z-index:1;"></div>
        <nav id="main-navbar" class="absolute top-0 left-0 w-full z-30 transition-colors duration-300">
            <div class="flex items-center justify-between px-4 py-2 md:px-6 md:py-2 relative">
                <div class="flex items-center gap-2">
                    <img src="../../public/assets/images/logo.png" alt="Logo" class="w-10 h-10 md:w-12 md:h-12 object-contain">
                </div>
                <button id="navbar-toggle" class="group flex flex-col items-center justify-center w-10 h-10 rounded-lg bg-white bg-opacity-10 hover:bg-opacity-20 transition relative z-40">
                    <span class="bar block w-7 h-1 bg-white mb-1.5 rounded transition-all duration-300" id="bar1"></span>
                    <span class="bar block w-7 h-1 bg-white mb-1.5 rounded transition-all duration-300" id="bar2"></span>
                    <span class="bar block w-7 h-1 bg-white rounded transition-all duration-300" id="bar3"></span>
                </button>
                <div id="navbar-menu" class="hidden absolute top-full right-0 mt-2 w-40 bg-[#2d2f3e] rounded-lg shadow-lg py-2 flex flex-col items-center animate-fade-in z-30">
                    <a href="#" class="text-white px-3 py-1 hover:bg-gray-700 w-full text-center text-sm">Dashboard</a>
                    <a href="#" class="text-white px-3 py-1 hover:bg-gray-700 w-full text-center text-sm">Bookings</a>
                    <a href="#" class="text-white px-3 py-1 hover:bg-gray-700 w-full text-center text-sm">Profile</a>
                    <a href="#" class="text-white px-3 py-1 hover:bg-gray-700 w-full text-center text-sm">Logout</a>
                </div>
            </div>
        </nav>
        <div class="absolute inset-0 flex items-center justify-center z-20">
            <h1 class="text-white text-2xl md:text-4xl lg:text-5xl font-bold drop-shadow-lg">My Bookings</h1>
        </div>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto px-2 py-4">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4 mt-2">
            <div class="flex items-center gap-2">
                <button class="px-4 py-1.5 rounded-full bg-green-600 text-white font-semibold shadow hover:bg-green-700 transition text-sm">New Booking</button>
                <!-- Filter Dropdown -->
                <div class="relative">
                    <button id="filter-btn" class="px-4 py-1.5 rounded-full bg-gray-200 text-gray-800 font-semibold shadow hover:bg-gray-300 transition flex items-center gap-1 text-sm">Filter <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></button>
                    <div id="filter-menu" class="hidden absolute left-0 mt-1 w-40 bg-white rounded-lg shadow-lg py-1 z-20">
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="filterBy('upcoming')">Upcoming</button>
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="filterBy('past')">Past</button>
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="filterBy('all')">All</button>
                    </div>
                </div>
                <!-- Sort Dropdown -->
                <div class="relative">
                    <button id="sort-btn" class="px-4 py-1.5 rounded-full bg-gray-200 text-gray-800 font-semibold shadow hover:bg-gray-300 transition flex items-center gap-1 text-sm">Sort <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg></button>
                    <div id="sort-menu" class="hidden absolute left-0 mt-1 w-40 bg-white rounded-lg shadow-lg py-1 z-20">
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="sortBy('arrival')">Arrival Date</button>
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="sortBy('return')">Return Date</button>
                        <button class="block w-full text-left px-3 py-1 hover:bg-gray-100 text-sm" onclick="sortBy('name')">Name</button>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-1">
                <span class="px-3 py-1 rounded-full bg-green-600 text-white font-semibold text-sm">Dubai</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="px-4 py-1.5 rounded-full bg-green-600 text-white font-semibold text-sm">Upcoming Trips</span>
                <span class="px-4 py-1.5 rounded-full bg-green-600 text-white font-semibold text-sm">1234@gmail.com</span>
            </div>
        </div>

        <div class="flex flex-col md:flex-row gap-2 mb-3">
            <button id="show-upcoming" class="flex-1 py-2 rounded-lg text-base font-bold bg-blue-600 text-white hover:bg-blue-700 transition">Upcoming bookings</button>
            <button id="show-past" class="flex-1 py-2 rounded-lg text-base font-bold bg-gray-300 text-gray-800 hover:bg-gray-400 transition">Past bookings</button>
        </div>

        <div id="upcoming-section" class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Example Booking Card 1 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-green-600">
                <h2 class="text-2xl font-bold">American Hotel</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> Gagandeep Singh</div>
                    <div><span class="font-semibold">From:</span> Dubai</div>
                    <div><span class="font-semibold">Arrival:</span> 2025-05-05 at 11:01</div>
                    <div><span class="font-semibold">Return:</span> 2025-05-06 at 11:01</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-green-600 text-white font-semibold hover:bg-green-700 transition">View this booking</button>
            </div>
            <!-- Example Booking Card 2 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-green-600">
                <h2 class="text-2xl font-bold">Palm Resort</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> Priya Sharma</div>
                    <div><span class="font-semibold">From:</span> Mumbai</div>
                    <div><span class="font-semibold">Arrival:</span> 2025-06-10 at 15:00</div>
                    <div><span class="font-semibold">Return:</span> 2025-06-15 at 12:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-green-600 text-white font-semibold hover:bg-green-700 transition">View this booking</button>
            </div>
            <!-- Example Booking Card 3 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-green-600">
                <h2 class="text-2xl font-bold">City Inn</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> Rahul Verma</div>
                    <div><span class="font-semibold">From:</span> Delhi</div>
                    <div><span class="font-semibold">Arrival:</span> 2025-07-01 at 09:30</div>
                    <div><span class="font-semibold">Return:</span> 2025-07-03 at 18:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-green-600 text-white font-semibold hover:bg-green-700 transition">View this booking</button>
            </div>
        </div>
        <div id="past-section" class="grid grid-cols-1 md:grid-cols-2 gap-8 hidden">
            <!-- Example Past Booking Card 1 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-gray-500">
                <h2 class="text-2xl font-bold">Past Hotel</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> John Doe</div>
                    <div><span class="font-semibold">From:</span> Dubai</div>
                    <div><span class="font-semibold">Arrival:</span> 2024-12-01 at 10:00</div>
                    <div><span class="font-semibold">Return:</span> 2024-12-05 at 10:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-gray-500 text-white font-semibold hover:bg-gray-600 transition">View this booking</button>
            </div>
            <!-- Example Past Booking Card 2 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-gray-500">
                <h2 class="text-2xl font-bold">Sunrise Suites</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> Aisha Khan</div>
                    <div><span class="font-semibold">From:</span> Abu Dhabi</div>
                    <div><span class="font-semibold">Arrival:</span> 2024-11-20 at 14:00</div>
                    <div><span class="font-semibold">Return:</span> 2024-11-22 at 11:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-gray-500 text-white font-semibold hover:bg-gray-600 transition">View this booking</button>
            </div>
            <!-- Example Past Booking Card 3 -->
            <div class="bg-white rounded-3xl shadow-lg p-6 flex flex-col gap-4 border-t-4 border-gray-500">
                <h2 class="text-2xl font-bold">Royal Stay</h2>
                <div class="text-gray-700">
                    <div><span class="font-semibold">Name:</span> Meera Patel</div>
                    <div><span class="font-semibold">From:</span> Jaipur</div>
                    <div><span class="font-semibold">Arrival:</span> 2024-10-10 at 12:00</div>
                    <div><span class="font-semibold">Return:</span> 2024-10-12 at 10:00</div>
                </div>
                <button class="mt-auto px-4 py-2 rounded-full bg-gray-500 text-white font-semibold hover:bg-gray-600 transition">View this booking</button>
            </div>
        </div>
    </main>

    <footer style="background-color: #2D2F3E; width: 100%; padding-top: 2.5rem; padding-bottom: 2.5rem;">
        <style>
            .footer-link {
                color: #fff;
                text-decoration: none;
                transition: color 0.2s;
            }
            .footer-link:hover {
                color: #16a34a; /* Tailwind green-600 */
            }
        </style>
        <div style="max-width: 1100px; margin: 0 auto; display: flex; flex-direction: row; justify-content: space-between; align-items: flex-start; gap: 0;">
            <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; min-width: 260px;">
                <img src="../../public/assets/images/logo.png" alt="Logo" style="height: 48px; width: auto; margin-bottom: 0.5rem;">
                <span style="color: #fff; font-size: 2rem; font-weight: bold; margin-bottom: 1rem;">ThePalmWay</span>
                <ul style="font-size: 1.25rem; list-style: none; padding: 0; margin: 0;">
                    <li style="margin-bottom: 0.5rem;"><a href="#" class="footer-link">About Us</a></li>
                    <li style="margin-bottom: 0.5rem;"><a href="#" class="footer-link">Careers</a></li>
                    <li style="margin-bottom: 0.5rem;"><a href="#" class="footer-link">Join Us</a></li>
                    <li><a href="#" class="footer-link">Partners</a></li>
                </ul>
            </div>
            <div style="border-left: 1px solid #8b8fa3; height: 140px; margin: 0 3rem;"></div>
            <div style="display: flex; flex-direction: column; align-items: flex-start; min-width: 260px; width: 100%;">
                <span style="color: #fff; font-size: 1.25rem; margin-bottom: 1.5rem;">Abc Avenue,<br>123 Street,<br>New York, USA</span>
                <div style="border-top: 1px solid #8b8fa3; width: 100%; margin: 1.5rem 0 1rem 0;"></div>
                <div style="display: flex; flex-direction: row; gap: 2.5rem;">
                    <a href="#" style="color: #fff; font-size: 2rem; display: flex; align-items: center;" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
                    <a href="#" style="color: #fff; font-size: 2rem; display: flex; align-items: center;" aria-label="X"><i class="fa fa-times"></i></a>
                    <a href="#" style="color: #fff; font-size: 2rem; display: flex; align-items: center;" aria-label="Email"><i class="fa fa-envelope"></i></a>
                </div>
            </div>
        </div>
        <div style="margin-top: 2.5rem; text-align: center; color: #bfc2d1; font-size: 1.15rem;">
            Copyrights reserved ThePalmWay © 2025
        </div>
    </footer>

    <script>
        // Parallax effect for header background
        const parallaxBg = document.getElementById('parallax-bg');
        window.addEventListener('scroll', function() {
            const scrolled = window.scrollY;
            // Move background slower than scroll for parallax
            parallaxBg.style.transform = `translateY(${scrolled * 0.4}px)`;
        });
        // Scroll-aware navbar background
        const navbar = document.getElementById('main-navbar');
        const header = navbar.parentElement;
        function updateNavbarBg() {
            const headerRect = header.getBoundingClientRect();
            if (headerRect.bottom <= 0) {
                navbar.style.background = '#2d2f3e';
                navbar.style.boxShadow = '0 2px 8px 0 rgba(0,0,0,0.08)';
            } else {
                navbar.style.background = 'transparent';
                navbar.style.boxShadow = 'none';
            }
        }
        window.addEventListener('scroll', updateNavbarBg);
        window.addEventListener('DOMContentLoaded', updateNavbarBg);


        // Toggle booking sections
        const showUpcomingBtn = document.getElementById('show-upcoming');
        const showPastBtn = document.getElementById('show-past');
        const upcomingSection = document.getElementById('upcoming-section');
        const pastSection = document.getElementById('past-section');

        showUpcomingBtn.addEventListener('click', () => {
            upcomingSection.classList.remove('hidden');
            pastSection.classList.add('hidden');
            showUpcomingBtn.classList.add('bg-blue-600', 'text-white');
            showUpcomingBtn.classList.remove('bg-gray-300', 'text-gray-800');
            showPastBtn.classList.remove('bg-blue-600', 'text-white');
            showPastBtn.classList.add('bg-gray-300', 'text-gray-800');
        });
        showPastBtn.addEventListener('click', () => {
            pastSection.classList.remove('hidden');
            upcomingSection.classList.add('hidden');
            showPastBtn.classList.add('bg-blue-600', 'text-white');
            showPastBtn.classList.remove('bg-gray-300', 'text-gray-800');
            showUpcomingBtn.classList.remove('bg-blue-600', 'text-white');
            showUpcomingBtn.classList.add('bg-gray-300', 'text-gray-800');
        });

        // Navbar hamburger/cross toggle
        const navbarToggle = document.getElementById('navbar-toggle');
        const navbarMenu = document.getElementById('navbar-menu');
        let navbarOpen = false;
        navbarToggle.addEventListener('click', () => {
            navbarOpen = !navbarOpen;
            if (navbarOpen) {
                navbarMenu.classList.remove('hidden');
                navbarToggle.classList.add('open');
                // Animate hamburger to symmetric cross (shorter arms)
                document.getElementById('bar1').style.transform = 'rotate(45deg) translateY(7px) scaleX(0.7)';
                document.getElementById('bar2').style.opacity = '0';
                document.getElementById('bar3').style.transform = 'rotate(-45deg) translateY(-7px) scaleX(0.7)';
            } else {
                navbarMenu.classList.add('hidden');
                navbarToggle.classList.remove('open');
                // Animate cross to hamburger
                document.getElementById('bar1').style.transform = '';
                document.getElementById('bar2').style.opacity = '';
                document.getElementById('bar3').style.transform = '';
            }
        });

        // Filter dropdown
        const filterBtn = document.getElementById('filter-btn');
        const filterMenu = document.getElementById('filter-menu');
        filterBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            filterMenu.classList.toggle('hidden');
            sortMenu.classList.add('hidden');
        });
        // Sort dropdown
        const sortBtn = document.getElementById('sort-btn');
        const sortMenu = document.getElementById('sort-menu');
        sortBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            sortMenu.classList.toggle('hidden');
            filterMenu.classList.add('hidden');
        });
        // Hide dropdowns on click outside
        document.addEventListener('click', () => {
            filterMenu.classList.add('hidden');
            sortMenu.classList.add('hidden');
        });

        // Dummy filter/sort functions
        function filterBy(type) {
            // Implement actual filtering logic here
            // No popup, just placeholder for future logic
        }
        function sortBy(type) {
            // Implement actual sorting logic here
            // No popup, just placeholder for future logic
        }
    </script>
</body>
</html>