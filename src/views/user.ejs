<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>My Bookings - Palm Ways</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<script src="https://cdn.tailwindcss.com"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
	<script>
		tailwind.config = {
			theme: {
				extend: {
					fontFamily: {
						'poppins': ['Poppins', 'sans-serif']
					},
                    colors: {
                        'primary-teal': '#008080',
                        'secondary-teal': '#00cec9',
                        'dark-teal': '#1a535c',
                    }
				}
			}
		}
	</script>
	<style>
		/* Custom Teal Gradient for Buttons */
		.teal-gradient-bg {
			background: linear-gradient(to right, #008080, #00cec9);
		}
		
		/* Text colors for customization */
		.text-primary-teal { color: #008080; }
		
		/* Responsive adjustments to grid columns */
		@media (min-width: 1024px) {
			.lg\:grid-cols-3 {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}
		}

		@media (max-width: 768px) {
			.md\:grid-cols-2 {
				grid-template-columns: repeat(1, minmax(0, 1fr));
			}
		}
	</style>
  </head>

  <body class="font-poppins bg-gray-100 min-h-screen pt-[76px]">
    <%- include('partials/navbar') %>
    <%- include('partials/alert') %>

    <div class="max-w-7xl mx-auto p-8">
      <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <h1 class="text-4xl font-bold text-gray-800 mb-2">My Bookings</h1>
          <p class="text-gray-500">Manage your travel reservations</p>
        </div>
        <a href="/api/booking" class="teal-gradient-bg text-white px-6 py-3 rounded-lg font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg inline-flex items-center gap-2">
          <i class="fas fa-plus"></i> New Booking
        </a>
      </div>

      <% if 
        (bookings && bookings.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
          <% bookings.forEach((booking) => { 
            const statusClass = booking.status ?
            booking.status.toLowerCase() : 'pending';
            const statusText = booking.status ? booking.status.charAt(0).toUpperCase() + booking.status.slice(1) : 'Pending';
            
            const arrivalDate = new Date(booking.arrivalDate || booking.arrival);
            const departureDate = new Date(booking.departureDate || booking.departure);
            const nights = Math.ceil((departureDate - arrivalDate) / (1000 * 60 * 60 * 24));
            const checkInDate = arrivalDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            const checkOutDate = departureDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            
            const totalAmount = booking.totalAmount || booking.price || 0;
            
            // Map status to a Teal-friendly palette
            let statusBg = 'bg-primary-teal'; // Pending (Teal)
            if (statusClass === 'confirmed') statusBg = 'bg-green-500';
            else if (statusClass === 'completed') statusBg = 'bg-dark-teal'; // Darker Teal for completed
            else if (statusClass === 'rejected') statusBg = 'bg-red-500';
          %>
            <div class="bg-white rounded-xl shadow-md overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-xl" data-booking-id="<%= booking._id %>">
              <div class="<%= statusBg %> text-white px-5 py-3 flex items-center gap-2 font-semibold text-sm">
                <i class="fas fa-circle text-xs"></i>
                <span><%= statusText %></span>
              </div>
              
              <div class="p-5">
                <h3 class="text-xl font-semibold text-gray-800 mb-4"><%= booking.hotelName ||
                booking.packageName || booking.title || booking.roomType || '' %></h3>
                
                <div class="space-y-3 mb-4">
                  <div class="flex items-center gap-2 text-gray-600 text-sm">
                    <i class="fas fa-calendar-check w-5 text-primary-teal"></i>
                    <span><strong>Check-in:</strong> <%= checkInDate %></span>
                  </div>
                  
                  <div class="flex items-center gap-2 text-gray-600 text-sm">
                    <i class="fas fa-calendar-times w-5 text-primary-teal"></i>
                    <span><strong>Check-out:</strong> <%= checkOutDate %></span>
                  </div>
                  
                  <div class="flex items-center gap-2 text-gray-600 text-sm">
                    <i class="fas fa-moon w-5 
                    text-primary-teal"></i>
                    <span><strong>Nights:</strong> <%= nights %></span>
                  </div>
                  
                  <div class="flex items-center gap-2 text-gray-600 text-sm">
                    <i class="fas fa-users w-5 text-primary-teal"></i>
                    <span><strong>Guests:</strong> <%= booking.adults ||
                    0 %> Adults<% if (booking.children && booking.children > 0) { %>, <%= booking.children %> Children<% } %></span>
                  </div>
                  
                  <% if (booking.bookingType) { %>
                  <div class="flex items-center gap-2 text-gray-600 text-sm">
                    <i class="fas fa-tag w-5 text-primary-teal"></i>
                    <span><strong>Type:</strong> <%= booking.bookingType %></span>
                  </div>
                  <% } %>
                </div>
  
                
                <div class="border-t border-gray-200 pt-4 mt-4">
                  <div class="text-2xl font-bold text-gray-800 mb-4">$<%= typeof totalAmount === 'number' ?
                  totalAmount.toFixed(2) : totalAmount %></div>
                  
                  <button class="w-full teal-gradient-bg text-white px-6 py-3 rounded-lg font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg flex items-center justify-center gap-2" onclick="viewDetails('<%= booking._id %>')">
                    <i class="fas fa-eye"></i> View Details
                  </button>
                </div>
              </div>
            </div>
          <% });
          %>
        </div>
      <% } else { %>
        <div class="text-center py-16 text-gray-500">
          <i class="fas fa-calendar-times text-6xl text-gray-300 mb-4"></i>
          <h3 class="text-2xl font-semibold text-gray-800 mb-2">No Bookings Yet</h3>
          <p class="text-base mb-6">You haven't made any reservations.
          Start planning your next adventure!</p>
          <a href="/api/booking" class="inline-block teal-gradient-bg text-white px-8 py-3 rounded-lg font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
            <i class="fas fa-plus"></i> New Booking
          </a>
        </div>
      <% } %>
    </div>

    <%- include('partials/footer') %>

    <script src="/assets/js/user.js"></script>
  </body>
</html>