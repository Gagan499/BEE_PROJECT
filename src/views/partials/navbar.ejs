<link rel="stylesheet" href="/assets/css/navbar.css">

<header class="main-header">
  <div class="header-container">
    <div class="logo-section" onclick="window.location.href='/'">
      <div class="logo-icon">
        <i class="fas fa-building"></i>
      </div>
      <div class="logo-text">
        <h1>Palm Ways</h1>
        <p>Luxury Resort & Spa</p>
      </div>
    </div>
    
    <div class="flex items-center gap-6">
        
        <nav 
 class="hidden lg:block">
            <ul class="nav-menu">
                <li><a href="/" id="nav-home">Home</a></li>
                <li><a href="/api/packages" id="nav-packages">Packages</a></li>
                <li><a href="#" id="nav-contact">Contact Us</a></li>
                <li id="nav-booking-li" style="display: none;"><a href="/api/booking" id="nav-booking">Booking</a></li>
          
              <li id="nav-my-bookings-li" style="display: none;"><a href="#" id="nav-my-bookings">My Bookings</a></li>
                <li id="nav-auth-li"><a href="/api/login" class="sign-in-btn" id="authLink">Sign In</a></li>
            </ul>
        </nav>
        
        <div class="auth-controls">
            <button 
                class="theme-toggle-desktop" 
 id="themeToggleDesktop" aria-label="Toggle Theme">
                <i class="fas fa-sun" id="themeIconDesktop"></i>
            </button>
            
            <div class="user-dropdown hidden" id="userDropdownDesktop">
                <a href="#" id="userIconDesktop" class="user-icon-btn" aria-label="User Profile">
                   
  <i class="fas fa-user-circle"></i>
                </a>
                <div class="user-dropdown-menu" id="userDropdownMenu">
                    <div class="dropdown-header">
                        <img src="https://i.pravatar.cc/40" alt="User Avatar" id="dropdownUserAvatar" class="w-10 h-10 rounded-full border-2 border-primary-teal object-cover" />
       
                      <div class="user-info">
                            <div class="user-name" id="dropdownUserName">User Name</div>
                            <div class="user-email" id="dropdownUserEmail">user@example.com</div>
                     
        </div>
                    </div>
                    <a href="#" id="dropdownUserInfo" class="dropdown-item">
                        <i class="fas fa-user"></i>
                        <span>User Info</span>
   
                      </a>
                    <a href="/api/change-password" class="dropdown-item">
                        <i class="fas fa-key"></i>
                        <span>Change Password</span>
          
                      </a>
                    <a href="#" id="dropdownLogout" class="dropdown-item logout">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                
        </a>
                </div>
            </div>

            <div class="mobile-group lg:hidden">
                <button class="theme-toggle-mobile" id="themeToggleMobile" aria-label="Toggle Theme">
             
                    <i 
 class="fas fa-sun" id="themeIconMobile"></i>
                </button>
                <button class="mobile-menu-btn" id="menuBtn" aria-label="Menu">
                    <i class="fas fa-bars"></i>   
              </button>
            </div>
        </div>
    </div>
  </div>
</header>

<div
  id="overlay"
  class="fixed inset-0 bg-black bg-opacity-50 hidden z-40"
></div>

<div
  id="sideMenu"
  class="fixed top-0 left-0 right-0 w-full bg-white dark:bg-gray-900 text-gray-800 dark:text-white transform translate-x-full transition-transform duration-300 ease-in-out z-[2000] shadow-2xl flex flex-col"
>
  <div class="bg-gradient-to-br from-primary-teal to-secondary-teal text-white p-4 relative">
    <div class="absolute top-4 right-4 flex items-center gap-3 z-10">
      <button
        class="theme-toggle-mobile-menu text-xl text-white focus:outline-none hover:opacity-80 transition-opacity"
        id="themeToggleMobileMenu"
        aria-label="Toggle Theme"
      >
        <i class="fas fa-sun" id="themeIconMobileMenu"></i>
      </button>
      <button
        id="closeBtn"
        class="text-2xl text-white focus:outline-none hover:opacity-80 transition-opacity"
      >
      
    <i class="fas fa-arrow-left"></i>
      </button>
    </div>
    
    <div class="flex items-center gap-3 pt-2 pb-3">
      <div class="logo-icon-mobile-menu">
        <i class="fas fa-building"></i>
      </div>
      <div class="logo-text-mobile-menu">
        <h1>Palm Ways</h1>
        <p>Luxury Resort & Spa</p>
      </div>
    </div>
    
  
    <div
      id="user_detail"
      class="flex items-center gap-3 pt-2 pb-2 hidden"
    >
      <img
          src="https://i.pravatar.cc/40"
          alt="User Avatar"
          id="mobile_user_avatar"
          class="w-12 h-12 rounded-full border-2 border-white object-cover shadow-lg"
        />
      
    <div>
        <p id="who_username" class="text-base font-semibold text-white mb-0.5"></p>
        <p id="mobile_user_email" class="text-xs text-white/80"></p>
      </div>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto px-4">
    <ul class="space-y-1">
      <li>
        <a href="/" class="flex items-center gap-3 text-base py-3 px-4 rounded-lg text-white hover:bg-white/20 transition-colors">
          <i class="fas fa-home w-5"></i>
          <span>Home</span>
 
        </a>
      </li>
      <li>
        <a href="/api/packages" class="flex items-center gap-3 text-base py-3 px-4 rounded-lg text-white hover:bg-white/20 transition-colors">
          <i class="fas fa-suitcase w-5"></i>
          <span>Packages</span>
        </a>
      </li>
      <li>
        <a href="#" id="mobile-contact" 
        
    class="flex items-center gap-3 text-base py-3 px-4 rounded-lg text-white hover:bg-white/20 transition-colors">
          <i class="fas fa-envelope w-5"></i>
          <span>Contact Us</span>
        </a>
      </li>
      <li id="mobile-booking-li" style="display: none;">
        <a href="/api/booking" class="flex items-center gap-3 text-base py-3 px-4 rounded-lg text-white hover:bg-white/20 transition-colors">
          <i class="fas fa-calendar-check w-5"></i>
        
    <span>Booking</span>
        </a>
      </li>
      <li id="mobile-my-bookings-li" style="display: none;">
        <a id="mobile-my-bookings" href="" class="flex items-center gap-3 text-base py-3 px-4 rounded-lg text-white hover:bg-white/20 transition-colors">
          <i class="fas fa-book w-5"></i>
          <span>My Bookings</span>
        </a>
      </li>
    </ul>

    <div id="mobile-user-actions" class="mt-2 px-4 hidden">
      <div class="border-t border-white/20 pt-3">
        <a
          href="/api/profile" id="mobile-user-info"
          class="flex items-center gap-3 text-base py-3 px-4 rounded-lg text-white hover:bg-white/20 transition-colors"
        >
          <i class="fas fa-user w-5"></i>
          <span>User Info</span>
        </a>
      
        <a
          id="change-password"
          href="/api/change-password"
          class="flex items-center gap-3 text-base py-3 px-4 rounded-lg text-white hover:bg-white/20 transition-colors"
        >
          <i class="fas fa-key w-5"></i>
          <span>Change Password</span>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/20 p-4">
    <a
      id="authLinkMobile"
      href="/api/login"
      class="block text-center text-base py-3 px-4 rounded-lg bg-white text-primary-teal hover:bg-white/90 transition-all font-semibold shadow-lg"
      >Login</a
    >
  </div>
</div>

<script src="/assets/js/navbar.js"></script>