<!-- Global Alert Component -->
<div id="globalAlert" class="fixed top-4 right-2 sm:right-4 z-[9999] max-w-md w-[calc(100%-1rem)] sm:w-full mx-2 sm:mx-4 hidden">
  <!-- Added dark:bg-gray-700 and dark:text-gray-200 for dark mode support -->
  <div id="alertContent" class="bg-white dark:bg-gray-700 rounded-lg shadow-2xl border-l-4 p-4 flex items-start gap-3 transform transition-all duration-500 ease-out translate-x-full opacity-0 scale-95 relative overflow-hidden group hover:shadow-3xl hover:scale-[1.02] transition-all duration-300">
    <!-- Progress Bar -->
    <div id="alertProgressBar" class="absolute bottom-0 left-0 h-1 bg-current opacity-30 transition-all ease-linear" style="width: 100%;"></div>
    
    <!-- Icon Container with Animation -->
    <div id="alertIcon" class="flex-shrink-0 mt-0.5 relative">
      <div id="iconWrapper" class="transform transition-all duration-500">
        <svg id="successIcon" class="w-6 h-6 text-green-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <svg id="errorIcon" class="w-6 h-6 text-red-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <svg id="warningIcon" class="w-6 h-6 text-yellow-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <svg id="infoIcon" class="w-6 h-6 text-blue-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <!-- Ripple Effect -->
      <div id="iconRipple" class="absolute inset-0 rounded-full opacity-0 pointer-events-none"></div>
    </div>
    
    <!-- Message Container -->
    <div class="flex-1 min-w-0">
      <!-- Applied dark:text-gray-100 -->
      <p id="alertMessage" class="text-sm font-medium text-gray-800 dark:text-gray-100 break-words transform transition-all duration-300"></p>
    </div>
    
    <!-- Close Button with Ripple -->
    <button id="alertCloseBtn" class="flex-shrink-0 text-gray-400 hover:text-gray-600 dark:hover:text-gray-100 transition-all duration-200 focus:outline-none relative p-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-600 group/close">
      <svg class="w-5 h-5 transform group-hover/close:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
      <span class="absolute inset-0 rounded-full bg-gray-200 dark:bg-gray-800 opacity-0 group-hover/close:opacity-20 group-hover/close:scale-150 transition-all duration-300"></span>
    </button>
  </div>
</div>

<style>
  @keyframes bounceIn {
    0% {
      transform: translateX(100%) scale(0.3);
      opacity: 0;
    }
    50% {
      transform: translateX(-10px) scale(1.05);
    }
    70% {
      transform: translateX(5px) scale(0.9);
    }
    100% {
      transform: translateX(0) scale(1);
      opacity: 1;
    }
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
    20%, 40%, 60%, 80% { transform: translateX(5px); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  @keyframes iconBounce {
    0% { transform: scale(0); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }

  @keyframes iconSpin {
    from { transform: rotate(0deg) scale(0); }
    to { transform: rotate(360deg) scale(1); }
  }

  @keyframes slideOut {
    0% {
      transform: translateX(0) scale(1);
      opacity: 1;
    }
    100% {
      transform: translateX(100%) scale(0.8);
      opacity: 0;
    }
  }

  @keyframes ripple {
    0% {
      transform: scale(0);
      opacity: 0.6;
    }
    100% {
      transform: scale(4);
      opacity: 0;
    }
  }

  .alert-bounce-in {
    animation: bounceIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
  }

  .alert-shake {
    animation: shake 0.5s ease-in-out;
  }

  .alert-pulse {
    animation: pulse 2s ease-in-out infinite;
  }

  .icon-bounce {
    animation: iconBounce 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  .icon-spin {
    animation: iconSpin 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  .alert-slide-out {
    animation: slideOut 0.4s ease-in forwards;
  }

  .ripple-effect {
    animation: ripple 0.6s ease-out;
  }
</style>

<script>
  // Global Alert System with Enhanced Animations
  (function() {
    const alertElement = document.getElementById('globalAlert');
    const alertContent = document.getElementById('alertContent');
    const alertMessage = document.getElementById('alertMessage');
    const alertCloseBtn = document.getElementById('alertCloseBtn');
    const alertProgressBar = document.getElementById('alertProgressBar');
    const iconWrapper = document.getElementById('iconWrapper');
    const iconRipple = document.getElementById('iconRipple');
    const successIcon = document.getElementById('successIcon');
    const errorIcon = document.getElementById('errorIcon');
    const warningIcon = document.getElementById('warningIcon');
    const infoIcon = document.getElementById('infoIcon');

    let alertTimeout = null;
    let progressInterval = null;
    let alertStartTime = null;
    let alertDuration = 5000;

    // Alert types configuration with animations
    const alertTypes = {
      success: {
        icon: successIcon,
        borderColor: 'border-green-500',
        bgColor: 'bg-green-50 dark:bg-green-900/20',
        iconAnimation: 'icon-bounce',
        contentAnimation: 'alert-bounce-in'
      },
      error: {
        icon: errorIcon,
        borderColor: 'border-red-500',
        bgColor: 'bg-red-50 dark:bg-red-900/20',
        iconAnimation: 'icon-spin',
        contentAnimation: 'alert-bounce-in alert-shake'
      },
      warning: {
        icon: warningIcon,
        borderColor: 'border-yellow-500',
        bgColor: 'bg-yellow-50 dark:bg-yellow-900/20',
        iconAnimation: 'icon-bounce',
        contentAnimation: 'alert-bounce-in alert-pulse'
      },
      info: {
        icon: infoIcon,
        borderColor: 'border-blue-500',
        bgColor: 'bg-blue-50 dark:bg-blue-900/20',
        iconAnimation: 'icon-bounce',
        contentAnimation: 'alert-bounce-in'
      }
    };

    function hideAllIcons() {
      successIcon.classList.add('hidden');
      errorIcon.classList.add('hidden');
      warningIcon.classList.add('hidden');
      infoIcon.classList.add('hidden');
    }

    function resetAnimations() {
      // Remove all animation classes
      alertContent.classList.remove(
        'alert-bounce-in', 'alert-shake', 'alert-pulse', 
        'alert-slide-out', 'translate-x-0', 'translate-x-full',
        'opacity-100', 'opacity-0', 'scale-95', 'scale-100'
      );
      iconWrapper.classList.remove('icon-bounce', 'icon-spin');
      iconRipple.classList.remove('ripple-effect');
    }

    function startProgressBar(duration) {
      alertDuration = duration;
      alertStartTime = Date.now();
      
      // Reset progress bar
      alertProgressBar.style.width = '100%';
      alertProgressBar.style.transition = 'none';
      
      // Start countdown
      setTimeout(() => {
        alertProgressBar.style.transition = `width ${duration}ms linear`;
        alertProgressBar.style.width = '0%';
      }, 50);
    }

    function animateIcon(type) {
      const config = alertTypes[type] || alertTypes.info;
      
      // Add icon animation
      setTimeout(() => {
        iconWrapper.classList.add(config.iconAnimation);
        
        // Add ripple effect
        iconRipple.classList.add('ripple-effect');
        iconRipple.style.backgroundColor = getComputedStyle(config.icon).color;
        
        // Remove animations after they complete
        setTimeout(() => {
          iconWrapper.classList.remove(config.iconAnimation);
          iconRipple.classList.remove('ripple-effect');
        }, 600);
      }, 100);
    }

    function animateMessage() {
      alertMessage.style.opacity = '0';
      alertMessage.style.transform = 'translateY(-10px)';
      
      setTimeout(() => {
        alertMessage.style.transition = 'all 0.4s ease-out';
        alertMessage.style.opacity = '1';
        alertMessage.style.transform = 'translateY(0)';
      }, 200);
    }

    function showAlert(message, type = 'info', duration = 5000) {
      // Clear any existing timeouts/intervals
      if (alertTimeout) {
        clearTimeout(alertTimeout);
      }
      if (progressInterval) {
        clearInterval(progressInterval);
      }

      // Reset everything
      resetAnimations();
      hideAllIcons();

      // Set message
      alertMessage.textContent = message;

      // Configure alert type
      const config = alertTypes[type] || alertTypes.info;
      config.icon.classList.remove('hidden');

      // Update border color and remove old ones
      alertContent.className = alertContent.className.replace(/border-(green|red|yellow|blue)-500/g, '');
      alertContent.classList.add(config.borderColor);
      
      // Apply background color for the content
      alertContent.className = alertContent.className.replace(/bg-(green|red|yellow|blue)-50 dark:bg-(green|red|yellow|blue)-900\/20/g, 'bg-white dark:bg-gray-700'); // Clean up old colors first
      // The current theme logic relies on Tailwind classes on the alertContent, 
      // but to ensure the background color aligns with the type's intent, we stick to the base color logic.
      // Since alert.ejs uses generic `bg-white dark:bg-gray-700`, we rely on `tailwind.config`
      // in the parent file to define the dark mode colors for the primary UI.

      // Show alert container
      alertElement.classList.remove('hidden');
      
      // Initial state
      alertContent.classList.add('translate-x-full', 'opacity-0', 'scale-95');
      
      // Trigger entrance animation
      setTimeout(() => {
        alertContent.classList.remove('translate-x-full', 'opacity-0', 'scale-95');
        alertContent.classList.add(config.contentAnimation, 'translate-x-0', 'opacity-100', 'scale-100');
        
        // Animate icon
        animateIcon(type);
        
        // Animate message
        animateMessage();
        
        // Start progress bar
        startProgressBar(duration);
      }, 10);

      // Auto hide after duration
      alertTimeout = setTimeout(() => {
        hideAlert();
      }, duration);

      // Close button handler with ripple effect
      alertCloseBtn.onclick = (e) => {
        // Create ripple effect on button
        const ripple = e.target.closest('button').querySelector('span');
        if (ripple) {
          ripple.style.animation = 'ripple 0.6s ease-out';
          setTimeout(() => {
            ripple.style.animation = '';
          }, 600);
        }
        hideAlert();
      };

      // Pause progress on hover (remove old listeners first)
      const oldEnter = alertContent._hoverEnter;
      const oldLeave = alertContent._hoverLeave;
      if (oldEnter) alertContent.removeEventListener('mouseenter', oldEnter);
      if (oldLeave) alertContent.removeEventListener('mouseleave', oldLeave);

      let pausedAt = null;
      let pausedWidth = null;

      const hoverEnter = () => {
        pausedWidth = parseFloat(alertProgressBar.style.width);
        pausedAt = Date.now();
        alertProgressBar.style.transition = 'none';
        alertProgressBar.style.width = `${pausedWidth}%`;
      };

      const hoverLeave = () => {
        if (pausedWidth !== null && pausedAt !== null) {
          const elapsed = Date.now() - alertStartTime;
          const remainingTime = alertDuration - elapsed;
          
          if (remainingTime > 0) {
            alertProgressBar.style.transition = `width ${remainingTime}ms linear`;
            alertProgressBar.style.width = '0%';
          }
        }
        pausedAt = null;
        pausedWidth = null;
      };

      alertContent._hoverEnter = hoverEnter;
      alertContent._hoverLeave = hoverLeave;
      alertContent.addEventListener('mouseenter', hoverEnter);
      alertContent.addEventListener('mouseleave', hoverLeave);
    }

    function hideAlert() {
      // Clear timeouts
      if (alertTimeout) {
        clearTimeout(alertTimeout);
        alertTimeout = null;
      }
      if (progressInterval) {
        clearInterval(progressInterval);
        progressInterval = null;
      }

      // Exit animation
      alertContent.classList.remove('alert-bounce-in', 'alert-shake', 'alert-pulse');
      alertContent.classList.add('alert-slide-out');
      
      setTimeout(() => {
        alertElement.classList.add('hidden');
        resetAnimations();
        hideAllIcons();
        alertProgressBar.style.width = '100%';
        alertProgressBar.style.transition = 'none';
      }, 400);
    }

    // Expose to global scope
    window.showAlert = showAlert;
    window.hideAlert = hideAlert;

    // Support for different alert methods
    window.alertSuccess = (message, duration) => showAlert(message, 'success', duration);
    window.alertError = (message, duration) => showAlert(message, 'error', duration);
    window.alertWarning = (message, duration) => showAlert(message, 'warning', duration);
    window.alertInfo = (message, duration) => showAlert(message, 'info', duration);

    // Override native alert (optional - can be disabled)
    // window.alert = function(message) {
    //   showAlert(message, 'info', 4000);
    // };
  })();
</script>